+	ulong start;
 
 	if (usid >= SPMI_MAX_SLAVES)
 		return -EIO;
@@ -162,9 +173,14 @@ static int msm_spmi_write(struct udevice *dev, int usid, int pid, int off,
 
 	/* Wait till CMD DONE status */
 	reg = 0;
+	start = IS_ENABLED(CONFIG_TB520FU_BOOTFLAG) ? get_timer(0) : 0;
