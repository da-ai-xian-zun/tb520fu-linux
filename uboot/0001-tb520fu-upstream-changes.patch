+/* TB520FU: give up on a transfer whose status never arrives (Linux waits 100 ms). */
+#define SPMI_STATUS_TIMEOUT_MS	200
+
+static bool spmi_status_timed_out(ulong start)
+{
+	return IS_ENABLED(CONFIG_TB520FU_BOOTFLAG) &&
+	       get_timer(start) > SPMI_STATUS_TIMEOUT_MS;
+}
+
 #define SPMI_CHANNEL_READ_ONLY	BIT(31)
 #define SPMI_CHANNEL_VALID	BIT(30)
 #define SPMI_CHANNEL_MASK	0xffff
@@ -110,6 +120,7 @@ static int msm_spmi_write(struct udevice *dev, int usid, int pid, int off,
