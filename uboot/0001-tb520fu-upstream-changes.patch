diff --git a/arch/arm/mach-snapdragon/Kconfig b/arch/arm/mach-snapdragon/Kconfig
index ddded002..00802db1 100644
--- a/arch/arm/mach-snapdragon/Kconfig
+++ b/arch/arm/mach-snapdragon/Kconfig
@@ -59,6 +59,15 @@ config QCOM_GENERATE_MBN
 	  New platforms can be added to tools/qcom/mkmbn/mkmbn.py if they aren't already
 	  supported.
 
+config TB520FU_BOOTFLAG
+	bool "TB520FU: one-shot boot selection flag in PMK8550 SDAM2"
+	depends on DM_PMIC && PMIC_QCOM
+	help
+	  Adds the bootflag command. Linux leaves a value in a spare PMIC SDAM
+	  byte to ask for Android on the next boot; the boot menu reads and
+	  clears it. Also bounds the SPMI status wait, so that a transfer
+	  that never completes returns an error instead of hanging the menu.
+
 choice
 	prompt "Qualcomm boot0.h workaround"
 	optional
