 obj-y += board_spl.o
 else
 obj-y += board.o
+obj-y += androidboot.o
+obj-$(CONFIG_TB520FU_BOOTFLAG) += bootflag.o
 obj-$(CONFIG_EFI_HAVE_CAPSULE_SUPPORT) += capsule_update.o
 endif
 
