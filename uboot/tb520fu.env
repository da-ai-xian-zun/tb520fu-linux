bootdelay=0
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# The Android kernel sits inside boot_a right after U-Boot.
android_addr=0xa8800000

# Mainline Linux is stored gzipped after Android and unpacked before starting.
linux_gz_addr=0xab400000
linux_addr=0xae000000
boot_linux=unzip $linux_gz_addr $linux_addr && androidboot $linux_addr; pause

# A timeout boots the first entry, Linux (the daily system since 2026-11-13). If the Linux entry
# returns (Image.gz did not unpack), bootcmd goes on to Android. A Linux that boots but fails
# later ends in the initramfs rescue shell, which reboots back here after 60 s without input.
# Linux can ask for Android on the next boot: it writes bootflag_android into the
# spare PMIC byte bootflag_reg and reboots (boot-switch/DESIGN.md). "bootflag take"
# succeeds only if the byte held that value and was cleared, so the request works once.
bootflag_reg=0x7150
bootflag_android=0xa5
bootflag_fastboot=0xa6
bootcmd=if bootflag take $bootflag_reg $bootflag_android; then echo "Android was requested from Linux"; androidboot $android_addr; elif bootflag take $bootflag_reg $bootflag_fastboot; then echo "Fastboot was requested"; bootflag reboot-mode bootloader; fi; bootmenu 5; androidboot $android_addr; pause

bootmenu_0=Linux=run boot_linux
bootmenu_1=Android=androidboot $android_addr; pause
bootmenu_2=Fastboot=bootflag reboot-mode bootloader; pause
bootmenu_3=Recovery=bootflag reboot-mode recovery; pause
bootmenu_4=Reboot=reset
bootmenu_5=Power off=poweroff
bootmenu_6=Board info=bdinfo; pause
bootmenu_7=Boot flag self-test=bootflag get $bootflag_reg; bootflag test $bootflag_reg; pause
