# TB520FU stage 1: boot menu only. U-Boot must leave storage alone, so every
# driver that is not needed for the display or the buttons is off.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8650-lenovo-tb520fu"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/tb520fu.env"
CONFIG_TB520FU_BOOTFLAG=y
CONFIG_PANIC_HANG=y
CONFIG_CMD_PAUSE=y
CONFIG_CMD_UNZIP=y
CONFIG_BUTTON_REMAP_PHONE_KEYS=y
CONFIG_BOOTDELAY=0
# CONFIG_USE_PREBOOT is not set
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
CONFIG_BUTTON_GPIO=y

# CONFIG_UFS is not set
# CONFIG_UFS_QCOM is not set
# CONFIG_SCSI is not set
# CONFIG_CMD_UFS is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_DFU_SCSI is not set
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_DFU_MMC is not set
# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DWC_ETH_QOS is not set
# CONFIG_NET is not set
# CONFIG_WDT is not set
# CONFIG_CMD_WDT is not set
# CONFIG_IOMMU is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_DM_RNG is not set
# CONFIG_DM_I2C is not set
# CONFIG_CMD_I2C is not set
# CONFIG_CMD_EEPROM is not set
# CONFIG_I2C_EEPROM is not set
# CONFIG_CLK_QCOM_SM8650 is not set
# CONFIG_QCOM_RPMH_POWER_DOMAIN is not set
# CONFIG_DM_REGULATOR_QCOM_RPMH is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# Loads serial-engine firmware from storage at init: not wanted here.
# CONFIG_QCOM_GENI is not set
# CONFIG_MSM_GENI_SERIAL is not set
# CONFIG_SYS_I2C_GENI is not set
# No distro boot in stage 1: the menu is all there is.
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTMETH_DISTRO is not set
# CONFIG_BOOTMETH_EXTLINUX is not set
# CONFIG_BOOTMETH_SCRIPT is not set
