From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: da-ai-xian-zun <163512031+da-ai-xian-zun@users.noreply.github.com>
Date: Tue, 17 Nov 2026 05:27:37 -0500
Subject: [PATCH 10/10] tb520fu: per-pid-namespace BPF object ID visibility

Android's netbpfload (Waydroid ZUI container) asserts that
BPF_{PROG,MAP}_GET_NEXT_ID(0) returns -ENOENT before loading the
tethering programs; the host systemd's cgroup programs made it exit 32.

Record the allocating task's pid namespace ns_id (64-bit, never reused;
ns.inum is recycled) for prog/map/link IDs in file-local xarrays, and
filter GET_NEXT_ID, GET_FD_BY_ID, bpf_{prog,link}_by_id (relative attach
by id) and the map/prog/link bpf_iter walkers for callers outside
init_pid_ns. init_pid_ns sees everything; BTF IDs and BPF_OBJ_GET are
untouched; no public header changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel/bpf/syscall.c | 146 ++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 138 insertions(+), 8 deletions(-)

diff --git a/kernel/bpf/syscall.c b/kernel/bpf/syscall.c
index 7a29e9c83..22c6f0f87 100644
--- a/kernel/bpf/syscall.c
+++ b/kernel/bpf/syscall.c
@@ -25,6 +25,8 @@
 #include <net/net_namespace.h>
 #include <linux/kernel.h>
 #include <linux/idr.h>
+#include <linux/pid_namespace.h>
+#include <linux/xarray.h>
 #include <linux/cred.h>
 #include <linux/timekeeping.h>
 #include <linux/ctype.h>
@@ -67,6 +69,87 @@ static DEFINE_SPINLOCK(map_idr_lock);
 static DEFINE_IDR(link_idr);
 static DEFINE_SPINLOCK(link_idr_lock);
 
+/*
+ * tb520fu: per-pid-namespace visibility of BPF object IDs.
+ *
+ * Android's netbpfload (Waydroid/LXC container) asserts that
+ * BPF_{PROG,MAP}_GET_NEXT_ID(0) returns -ENOENT before it loads anything,
+ * but the host's systemd has already loaded cgroup programs.  Record the
+ * pid namespace (ns_tree ns_id: 64-bit, never reused, unlike ns.inum) of
+ * the task that allocated each prog/map/link ID, and let tasks outside
+ * init_pid_ns see and open by ID only the objects created in their own pid
+ * namespace.  init_pid_ns sees everything.  BTF IDs and BPF_OBJ_GET (bpffs
+ * pins) are unaffected.
+ *
+ * Side tables keyed by object ID (the three IDRs are separate ID spaces);
+ * only objects created outside init_pid_ns get an entry, so a missing entry
+ * means "host object".  Entries are written/erased under the IDR spinlock;
+ * the xarray lock nests inside it and is taken irqsave because the free
+ * paths run with IRQs disabled.  No public struct changes (module ABI kept).
+ */
+static DEFINE_XARRAY_FLAGS(prog_ns_xa, XA_FLAGS_LOCK_IRQ);
+static DEFINE_XARRAY_FLAGS(map_ns_xa, XA_FLAGS_LOCK_IRQ);
+static DEFINE_XARRAY_FLAGS(link_ns_xa, XA_FLAGS_LOCK_IRQ);
+
+/* 0 for init_pid_ns (unfiltered), else the caller's pid ns_id */
+static u64 bpf_id_cur_nsid(void)
+{
+	struct pid_namespace *ns = task_active_pid_ns(current);
+
+	if (!ns || ns == &init_pid_ns)
+		return 0;
+	return ns->ns.ns_id;
+}
+
+static struct xarray *bpf_id_ns_xa(const struct idr *idr)
+{
+	if (idr == &prog_idr)
+		return &prog_ns_xa;
+	if (idr == &map_idr)
+		return &map_ns_xa;
+	if (idr == &link_idr)
+		return &link_ns_xa;
+	return NULL;	/* btf_idr: never filtered */
+}
+
+/* caller holds the matching IDR lock */
+static int bpf_id_ns_record(struct xarray *xa, u32 id)
+{
+	u64 nsid = bpf_id_cur_nsid();
+	unsigned long flags;
+	void *old;
+
+	if (!nsid)
+		return 0;
+	xa_lock_irqsave(xa, flags);
+	old = __xa_store(xa, id, xa_mk_value(nsid), GFP_ATOMIC);
+	xa_unlock_irqrestore(xa, flags);
+	return xa_err(old);
+}
+
+/* caller holds the matching IDR lock */
+static void bpf_id_ns_forget(struct xarray *xa, u32 id)
+{
+	unsigned long flags;
+
+	if (xa_empty(xa))
+		return;
+	xa_lock_irqsave(xa, flags);
+	__xa_erase(xa, id);
+	xa_unlock_irqrestore(xa, flags);
+}
+
+static bool bpf_id_ns_visible(struct xarray *xa, u32 id)
+{
+	u64 nsid = bpf_id_cur_nsid();
+	void *v;
+
+	if (!nsid || !xa)
+		return true;
+	v = xa_load(xa, id);
+	return v && xa_to_value(v) == nsid;
+}
+
 int sysctl_unprivileged_bpf_disabled __read_mostly =
 	IS_BUILTIN(CONFIG_BPF_UNPRIV_DEFAULT_OFF) ? 2 : 0;
 
@@ -453,8 +536,14 @@ static int bpf_map_alloc_id(struct bpf_map *map)
 	idr_preload(GFP_KERNEL);
 	spin_lock_bh(&map_idr_lock);
 	id = idr_alloc_cyclic(&map_idr, map, 1, INT_MAX, GFP_ATOMIC);
-	if (id > 0)
-		map->id = id;
+	if (id > 0) {
+		if (bpf_id_ns_record(&map_ns_xa, id)) {
+			idr_remove(&map_idr, id);
+			id = -ENOMEM;
+		} else {
+			map->id = id;
+		}
+	}
 	spin_unlock_bh(&map_idr_lock);
 	idr_preload_end();
 
@@ -479,6 +568,7 @@ void bpf_map_free_id(struct bpf_map *map)
 	spin_lock_irqsave(&map_idr_lock, flags);
 
 	idr_remove(&map_idr, map->id);
+	bpf_id_ns_forget(&map_ns_xa, map->id);
 	map->id = 0;
 
 	spin_unlock_irqrestore(&map_idr_lock, flags);
@@ -2409,8 +2499,14 @@ static int bpf_prog_alloc_id(struct bpf_prog *prog)
 	idr_preload(GFP_KERNEL);
 	spin_lock_bh(&prog_idr_lock);
 	id = idr_alloc_cyclic(&prog_idr, prog, 1, INT_MAX, GFP_ATOMIC);
-	if (id > 0)
-		prog->aux->id = id;
+	if (id > 0) {
+		if (bpf_id_ns_record(&prog_ns_xa, id)) {
+			idr_remove(&prog_idr, id);
+			id = -ENOMEM;
+		} else {
+			prog->aux->id = id;
+		}
+	}
 	spin_unlock_bh(&prog_idr_lock);
 	idr_preload_end();
 
@@ -2435,6 +2531,7 @@ void bpf_prog_free_id(struct bpf_prog *prog)
 
 	spin_lock_irqsave(&prog_idr_lock, flags);
 	idr_remove(&prog_idr, prog->aux->id);
+	bpf_id_ns_forget(&prog_ns_xa, prog->aux->id);
 	prog->aux->id = 0;
 	spin_unlock_irqrestore(&prog_idr_lock, flags);
 }
@@ -3282,6 +3379,7 @@ static void bpf_link_free_id(int id)
 
 	spin_lock_bh(&link_idr_lock);
 	idr_remove(&link_idr, id);
+	bpf_id_ns_forget(&link_ns_xa, id);
 	spin_unlock_bh(&link_idr_lock);
 }
 
@@ -3499,6 +3597,10 @@ static int bpf_link_alloc_id(struct bpf_link *link)
 	idr_preload(GFP_KERNEL);
 	spin_lock_bh(&link_idr_lock);
 	id = idr_alloc_cyclic(&link_idr, link, 1, INT_MAX, GFP_ATOMIC);
+	if (id > 0 && bpf_id_ns_record(&link_ns_xa, id)) {
+		idr_remove(&link_idr, id);
+		id = -ENOMEM;
+	}
 	spin_unlock_bh(&link_idr_lock);
 	idr_preload_end();
 
@@ -4834,6 +4936,7 @@ static int bpf_obj_get_next_id(const union bpf_attr *attr,
 			       spinlock_t *lock)
 {
 	u32 next_id = attr->start_id;
+	struct xarray *xa;
 	int err = 0;
 
 	if (CHECK_ATTR(BPF_OBJ_GET_NEXT_ID) || next_id >= INT_MAX)
@@ -4842,10 +4945,23 @@ static int bpf_obj_get_next_id(const union bpf_attr *attr,
 	if (!capable(CAP_SYS_ADMIN))
 		return -EPERM;
 
+	xa = bpf_id_ns_xa(idr);
 	next_id++;
 	spin_lock_bh(lock);
-	if (!idr_get_next(idr, &next_id))
-		err = -ENOENT;
+	for (;;) {
+		if (!idr_get_next(idr, &next_id)) {
+			err = -ENOENT;
+			break;
+		}
+		if (bpf_id_ns_visible(xa, next_id))
+			break;
+		/* IDs are allocated in [1, INT_MAX) */
+		if (next_id >= INT_MAX - 1) {
+			err = -ENOENT;
+			break;
+		}
+		next_id++;
+	}
 	spin_unlock_bh(lock);
 
 	if (!err)
@@ -4861,6 +4977,10 @@ struct bpf_map *bpf_map_get_curr_or_next(u32 *id)
 	spin_lock_bh(&map_idr_lock);
 again:
 	map = idr_get_next(&map_idr, id);
+	if (map && !bpf_id_ns_visible(&map_ns_xa, *id)) {
+		(*id)++;
+		goto again;
+	}
 	if (map) {
 		map = __bpf_map_inc_not_zero(map, false);
 		if (IS_ERR(map)) {
@@ -4880,6 +5000,10 @@ struct bpf_prog *bpf_prog_get_curr_or_next(u32 *id)
 	spin_lock_bh(&prog_idr_lock);
 again:
 	prog = idr_get_next(&prog_idr, id);
+	if (prog && !bpf_id_ns_visible(&prog_ns_xa, *id)) {
+		(*id)++;
+		goto again;
+	}
 	if (prog) {
 		prog = bpf_prog_inc_not_zero(prog);
 		if (IS_ERR(prog)) {
@@ -4903,7 +5027,7 @@ struct bpf_prog *bpf_prog_by_id(u32 id)
 
 	spin_lock_bh(&prog_idr_lock);
 	prog = idr_find(&prog_idr, id);
-	if (prog)
+	if (prog && bpf_id_ns_visible(&prog_ns_xa, id))
 		prog = bpf_prog_inc_not_zero(prog);
 	else
 		prog = ERR_PTR(-ENOENT);
@@ -4956,7 +5080,7 @@ static int bpf_map_get_fd_by_id(const union bpf_attr *attr)
 
 	spin_lock_bh(&map_idr_lock);
 	map = idr_find(&map_idr, id);
-	if (map)
+	if (map && bpf_id_ns_visible(&map_ns_xa, id))
 		map = __bpf_map_inc_not_zero(map, true);
 	else
 		map = ERR_PTR(-ENOENT);
@@ -6041,6 +6165,8 @@ struct bpf_link *bpf_link_by_id(u32 id)
 	spin_lock_bh(&link_idr_lock);
 	/* before link is "settled", ID is 0, pretend it doesn't exist yet */
 	link = idr_find(&link_idr, id);
+	if (link && !bpf_id_ns_visible(&link_ns_xa, id))
+		link = NULL;
 	if (link) {
 		if (link->id)
 			link = bpf_link_inc_not_zero(link);
@@ -6060,6 +6186,10 @@ struct bpf_link *bpf_link_get_curr_or_next(u32 *id)
 	spin_lock_bh(&link_idr_lock);
 again:
 	link = idr_get_next(&link_idr, id);
+	if (link && !bpf_id_ns_visible(&link_ns_xa, *id)) {
+		(*id)++;
+		goto again;
+	}
 	if (link) {
 		if (link->id)
 			link = bpf_link_inc_not_zero(link);
