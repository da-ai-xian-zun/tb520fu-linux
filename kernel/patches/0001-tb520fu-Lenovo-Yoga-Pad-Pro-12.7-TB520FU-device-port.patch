+{
+	struct q6apm_mem_lease *lease;
+
+	lockdep_assert_held(&apm->lock);
+	list_for_each_entry(lease, &apm->mem_leases, node)
+		if (lease->generation == generation && lease->graph_id == graph_id)
+			return lease;
