+
+/*
+ * Checksum calculation: 1-byte two's complement sum of payload bytes
+ */
+static u8 lenovo_calc_checksum(const u8 *data, size_t len)
+{
+	u8 sum = 0;
+	size_t i;
+
+	/*
+	 * The MCU sums 0x7d and 0x7e in their stuffed form, which adds 0x5d for
+	 * each. Other stuffed bytes count at their plain value.
+	 */
+	for (i = 0; i < len; i++) {
+		sum += data[i];
+		if (data[i] == PPP_FLAG_BYTE || data[i] == PPP_ESC_BYTE)
+			sum += 0x5d;
+	}
+	return sum;
+}
+
+/*
+ * Scramble payload in-place using seed byte and 64-byte keyDict
+ */
+static void lenovo_scram(u8 seed, u8 *buf, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		buf[i] ^= lenovo_key_dict[(seed + i) & 0x3f];
+}
+
+/*
+ * Descramble payload in-place using seed byte and 64-byte keyDict
+ */
+static void lenovo_disscram(u8 seed, u8 *buf, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		buf[i] ^= lenovo_key_dict[(seed + i) & 0x3f];
+}
+
+/*
+ * PPP Frame Encoder:
+ *   out[0] = 0x7e, out[1] = 0xff,
+ *   followed by byte-stuffed payload[0..len-1],
+ *   terminated by 0x7e.
+ */
+static size_t lenovo_ppp_encode(const u8 *in, size_t len, u8 *out, size_t out_max)
+{
+	size_t pos = 0;
+	size_t i;
+
+	if (out_max < 5)
+		return 0;
+
+	/*
+	 * Match the vendor driver's frame exactly: two leading flag bytes, and
+	 * only the flag and escape bytes are escaped. Escaping other bytes
+	 * (< 0x20) is suspected to make the MCU drop the frame.
+	 */
+	out[pos++] = PPP_FLAG_BYTE;
+	out[pos++] = PPP_FLAG_BYTE;
+	out[pos++] = PPP_ADDR_BYTE;
+
+	for (i = 0; i < len; i++) {
+		u8 b = in[i];
+
+		if (b == PPP_FLAG_BYTE || b == PPP_ESC_BYTE) {
+			if (pos + 3 > out_max)
+				return 0;
+			out[pos++] = PPP_ESC_BYTE;
+			out[pos++] = b ^ PPP_ESC_XOR;
+		} else {
+			if (pos + 2 > out_max)
+				return 0;
+			out[pos++] = b;
+		}
+	}
+
+	out[pos++] = PPP_FLAG_BYTE;
+	return pos;
+}
+
+/*
+ * Transmit a command payload to the keyboard MCU over the one-wire half-duplex
+ * GENI UART bus.
+ *
+ * Frame layout before PPP encoding:
+ *   raw[0]         = random seed (0x00..0x7f)
+ *   raw[1..len]    = cmd[0..len-1]
+ *   raw[len + 1]   = two's complement checksum of cmd[0..len-1]
+ *   Then raw[1..len+1] is XOR-scrambled with raw[0] via lenovo_scram().
+ */
+static int lenovo_kb_send_cmd(struct lenovo_kb_dev *kb, const u8 *cmd, size_t len)
+{
+	u8 raw[64];
+	u8 encoded[140];
+	size_t enc_len;
+	u8 seed;
+	int ret = 0;
+
+	if (!kb->connected || len == 0 || len + 2 > sizeof(raw))
+		return -ENODEV;
+
+	seed = get_random_u8() & 0x7f;
+	raw[0] = seed;
+	memcpy(&raw[1], cmd, len);
+	/* The checksum covers the seed and the scrambled bytes, and is not scrambled. */
+	lenovo_scram(seed, &raw[1], len);
+	raw[len + 1] = lenovo_calc_checksum(raw, len + 1);
+	enc_len = lenovo_ppp_encode(raw, len + 2, encoded, sizeof(encoded));
+	if (!enc_len)
+		return -EMSGSIZE;
+
+	mutex_lock(&kb->tx_lock);
+
+	/* Switch one-wire transceiver to Host-TX mode */
+	if (kb->tx_en_gpio) {
+		gpiod_set_value_cansleep(kb->tx_en_gpio, 1);
+		usleep_range(400, 500);
+	}
+
+	ret = serdev_device_write_buf(kb->serdev, encoded, enc_len);
+	if (ret > 0) {
+		serdev_device_wait_until_sent(kb->serdev, msecs_to_jiffies(50));
+		ret = 0;
+	}
+
+	/* Return one-wire transceiver to Host-RX mode */
+	if (kb->tx_en_gpio) {
+		usleep_range(200, 300);
+		gpiod_set_value_cansleep(kb->tx_en_gpio, 0);
+	}
+
+	mutex_unlock(&kb->tx_lock);
+	return ret;
+}
+
+static int lenovo_kb_set_caps_led(struct lenovo_kb_dev *kb, bool on)
+{
+	const u8 cmd[] = { 0x6a, 0x03, 0x27, 0x01, on ? 1 : 0 };
+
+	kb->caps_led = on;
+	kb->sent_caps = on;
+	return lenovo_kb_send_cmd(kb, cmd, sizeof(cmd));
+}
