+static u32 msm_dp_dsc_extra_width(u32 line_width, u32 ack_required,
+				  u32 dto_n, u32 dto_d)
+{
+	int last_few_pclk, last_few_ack_required, accum_ack = 0;
+	int last_few_pclk_required = 0;
+	u32 remainder = dto_n, start;
+
+	last_few_pclk = line_width % dto_d;
+	last_few_ack_required = (int)ack_required -
+				(int)((line_width / dto_d) * dto_n +
+				      ((line_width % dto_d) * dto_n) / dto_d);
+
+	while (accum_ack < last_few_ack_required) {
+		last_few_pclk_required++;
+		start = remainder >= dto_n ? remainder : remainder + dto_d;
+		remainder = start - dto_n;
+		if (remainder < dto_n)
+			accum_ack++;
+		if (last_few_pclk_required > 4 * (int)dto_d)
+			break;
