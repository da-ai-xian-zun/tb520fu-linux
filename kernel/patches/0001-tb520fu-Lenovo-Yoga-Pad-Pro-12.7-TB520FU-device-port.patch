+
+		section_end = (size_t)cfg_dde[i].data_offset +
+			      cfg_dde[i].data_size;
+		for (j = 0; j < i; j++) {
+			size_t prev_end = (size_t)cfg_dde[j].data_offset +
+					  cfg_dde[j].data_size;
+
+			if (cfg_dde[i].data_size && cfg_dde[j].data_size &&
+			    cfg_dde[i].data_offset < prev_end &&
+			    cfg_dde[j].data_offset < section_end) {
