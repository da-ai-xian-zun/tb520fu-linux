  */
-#define MAX_INBOUND_BUFFER_SIZE SZ_4M
+#define MAX_INBOUND_BUFFER_SIZE SZ_16M
+
+/* Driver-private tee_shm flag: buffer backed by CMA (see pool_op_alloc). */
