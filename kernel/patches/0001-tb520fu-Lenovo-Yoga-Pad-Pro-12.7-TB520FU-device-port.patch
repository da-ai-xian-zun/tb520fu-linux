+static ssize_t pen_charge_state_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct nvt_ts_data *ts_data = dev_get_drvdata(dev);
+
+	if (!ts_data || READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	return sysfs_emit(buf, "%d\n", ts_data->pen_is_charge ? 1 : 0);
+}
+
+static ssize_t pen_charge_state_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct nvt_ts_data *ts_data = dev_get_drvdata(dev);
+	bool charge;
+	int ret;
+
+	if (!ts_data || READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	ret = kstrtobool(buf, &charge);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ts_data->lock);
+	if (ts_data->pen_is_charge != charge) {
+		ts_data->pen_is_charge = charge;
+		if (nvt_touch_awake)
+			disable_pen_input_device(charge);
+	}
+	mutex_unlock(&ts_data->lock);
+
+	return count;
+}
+static DEVICE_ATTR_RW(pen_charge_state);
+
+#if BOOT_UPDATE_FIRMWARE
+/*
+ * Reload the firmware on request, the same way ESD/WDT recovery does (no
+ * panel reset).  Also brings the chip back after a failed recovery.
+ */
+static ssize_t fw_reload_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct nvt_ts_data *ts_data = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	if (!ts_data || READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+	if (!val)
+		return count;
+
+	if (ts_data->irq_enabled)
+		nvt_irq_enable(false);
+
+	mutex_lock(&ts_data->lock);
+	NVT_LOG("firmware reload requested, SWRST_N8_ADDR=0x%06X\n", SWRST_N8_ADDR);
+	ret = nvt_update_firmware(ts_data->fw_name);
+	if (!ret)
+		ret = nvt_check_fw_reset_state(RESET_STATE_REK);
+	if (ret) {
+		nvt_recovery_failed(ret);
+		mutex_unlock(&ts_data->lock);
+		return ret;
+	}
+	if (ts_data->ic_state == -EIO)
+		ts_data->ic_state = NVT_IC_RESUME_OUT;
+	nvt_touch_awake = true;
+	mutex_unlock(&ts_data->lock);
+
+	nvt_irq_enable(true);
+	disable_pen_input_device(ts_data->pen_is_charge);
+
+	return count;
+}
+static DEVICE_ATTR_WO(fw_reload);
+#endif
+
+#ifdef NVT_SWRST_DEBUG
+/* Test builds only: change the software reset address at run time. */
+static ssize_t swrst_addr_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "0x%06X\n", SWRST_N8_ADDR);
+}
+
+static ssize_t swrst_addr_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct nvt_ts_data *ts_data = dev_get_drvdata(dev);
+	u32 addr;
+	int ret;
+
+	if (!ts_data || READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	ret = kstrtou32(buf, 0, &addr);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ts_data->lock);
+	SWRST_N8_ADDR = addr;
+	mutex_unlock(&ts_data->lock);
+
+	return count;
+}
+static DEVICE_ATTR_RW(swrst_addr);
+#endif
+
+static struct attribute *nvt_dev_attrs[] = {
+	&dev_attr_pen_charge_state.attr,
+#if BOOT_UPDATE_FIRMWARE
+	&dev_attr_fw_reload.attr,
+#endif
+#ifdef NVT_SWRST_DEBUG
+	&dev_attr_swrst_addr.attr,
+#endif
+	NULL
+};
+ATTRIBUTE_GROUPS(nvt_dev);
+
+static struct spi_driver nvt_spi_driver = {
+	.probe		= nvt_ts_probe,
+	.remove		= nvt_ts_remove,
+	.shutdown	= nvt_ts_shutdown,
+	.id_table	= nvt_ts_id,
+	.driver = {
+		.name	= NVT_SPI_NAME,
+		.owner	= THIS_MODULE,
+		.dev_groups = nvt_dev_groups,
+#ifdef CONFIG_PM
+		.pm = &nvt_dev_pm_ops,
+#endif
+#ifdef CONFIG_OF
+		.of_match_table = nvt_match_table,
+#endif
+	},
+};
+
+module_spi_driver(nvt_spi_driver);
+
+MODULE_DESCRIPTION("Novatek Touchscreen Driver");
+MODULE_LICENSE("GPL");
