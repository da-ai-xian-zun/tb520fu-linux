+	u32 old_state = battmgr->pen_state;
+	int old_level = battmgr->pen_level;
+	u32 val;
+
+	if (battmgr->service_up) {
+		if (!qcom_battmgr_lenovo_qi_read(battmgr, LENOVO_QI_PROP_STATE,
+						 &val))
+			battmgr->pen_state = val;
