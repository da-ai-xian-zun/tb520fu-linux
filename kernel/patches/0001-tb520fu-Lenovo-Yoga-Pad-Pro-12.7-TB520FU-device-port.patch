+static int lenovo_kb_setup_inputs(struct lenovo_kb_dev *kb)
+{
+	int i, ret;
+
+	/* 1. Keyboard Input Device */
+	kb->kb_input = devm_input_allocate_device(kb->dev);
+	if (!kb->kb_input)
+		return -ENOMEM;
+
+	kb->kb_input->name = LENOVO_KB_NAME;
+	kb->kb_input->phys = "lenovo-kb/input0";
+	kb->kb_input->id.bustype = BUS_HOST;
+	kb->kb_input->id.vendor = LENOVO_KB_VENDOR_ID;
+	kb->kb_input->id.product = LENOVO_KB_PRODUCT_ID;
+	kb->kb_input->id.version = LENOVO_KB_VERSION_ID;
+	kb->kb_input->event = lenovo_kb_input_event;
+	input_set_drvdata(kb->kb_input, kb);
+
+	__set_bit(EV_KEY, kb->kb_input->evbit);
+	__set_bit(EV_REP, kb->kb_input->evbit);
+	__set_bit(EV_LED, kb->kb_input->evbit);
+	__set_bit(LED_CAPSL, kb->kb_input->ledbit);
+	__set_bit(LED_MUTE, kb->kb_input->ledbit);
+	__set_bit(LED_MISC, kb->kb_input->ledbit);
+	input_set_capability(kb->kb_input, EV_MSC, MSC_SCAN);
+
+	for (i = 0; i < 256; i++) {
+		if (lenovo_hid_to_sc[i])
+			__set_bit(lenovo_hid_to_sc[i], kb->kb_input->keybit);
+	}
+	for (i = 0; i < ARRAY_SIZE(lenovo_modifier_sc); i++)
+		__set_bit(lenovo_modifier_sc[i], kb->kb_input->keybit);
+	for (i = 0; i < ARRAY_SIZE(lenovo_custom_keys); i++) {
+		__set_bit(lenovo_custom_keys[i].android_sc, kb->kb_input->keybit);
+		__set_bit(lenovo_custom_keys[i].linux_sc, kb->kb_input->keybit);
+	}
+
+	ret = input_register_device(kb->kb_input);
+	if (ret)
+		return ret;
+
+	/* 2. Multi-Touch Type B Touchpad Input Device */
+	kb->tp_input = devm_input_allocate_device(kb->dev);
+	if (!kb->tp_input)
+		return -ENOMEM;
+
+	kb->tp_input->name = LENOVO_TP_NAME;
+	kb->tp_input->phys = "lenovo-kb/input1";
+	kb->tp_input->id.bustype = BUS_HOST;
+	kb->tp_input->id.vendor = LENOVO_KB_VENDOR_ID;
+	kb->tp_input->id.product = LENOVO_KB_PRODUCT_ID;
+	kb->tp_input->id.version = LENOVO_KB_VERSION_ID;
+	input_set_drvdata(kb->tp_input, kb);
+
+	__set_bit(INPUT_PROP_POINTER, kb->tp_input->propbit);
+	__set_bit(INPUT_PROP_BUTTONPAD, kb->tp_input->propbit);
+
+	input_set_capability(kb->tp_input, EV_KEY, BTN_LEFT);
+	input_set_abs_params(kb->tp_input, ABS_MT_POSITION_X, 0, LENOVO_TP_MAX_X, 0, 0);
+	input_set_abs_params(kb->tp_input, ABS_MT_POSITION_Y, 0, LENOVO_TP_MAX_Y, 0, 0);
+	/* Estimated from a touchpad of about 128 x 75 mm. */
+	input_abs_set_res(kb->tp_input, ABS_MT_POSITION_X, 25);
+	input_abs_set_res(kb->tp_input, ABS_MT_POSITION_Y, 25);
+
+	ret = input_mt_init_slots(kb->tp_input, LENOVO_TP_MAX_SLOTS,
+				  INPUT_MT_POINTER | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+
+	ret = input_register_device(kb->tp_input);
+	if (ret)
+		return ret;
+
+	/* 3. Magnetic Lid Switch Input Device */
+	kb->lid_input = devm_input_allocate_device(kb->dev);
+	if (!kb->lid_input)
+		return -ENOMEM;
+
+	kb->lid_input->name = LENOVO_LID_NAME;
+	kb->lid_input->phys = "lenovo-kb/input2";
+	kb->lid_input->id.bustype = BUS_HOST;
+	kb->lid_input->id.vendor = LENOVO_KB_VENDOR_ID;
+	kb->lid_input->id.product = LENOVO_KB_PRODUCT_ID;
+	kb->lid_input->id.version = LENOVO_KB_VERSION_ID;
+	input_set_capability(kb->lid_input, EV_SW, SW_LID);
+	input_set_capability(kb->lid_input, EV_SW, SW_TABLET_MODE);
+
+	return input_register_device(kb->lid_input);
+}
