+
+static void aw882xx_dev_count_put(void)
+{
+	mutex_lock(&g_aw882xx_lock);
+	if (WARN_ON(atomic_read(&g_aw882xx_dev_cnt) <= 0)) {
+		mutex_unlock(&g_aw882xx_lock);
+		return;
+	}
+
+	if (atomic_dec_and_test(&g_aw882xx_dev_cnt)) {
+		vfree(g_awinic_cfg);
+		g_awinic_cfg = NULL;
+	}
+	mutex_unlock(&g_aw882xx_lock);
