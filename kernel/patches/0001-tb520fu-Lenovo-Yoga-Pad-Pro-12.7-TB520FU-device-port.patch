+static int lenovo_kb_restore_leds(struct lenovo_kb_dev *kb)
+{
+	const u8 cmd[] = {
+		0x6a, 0x06, 0x2b, 0x04,
+		kb->caps_led ? 1 : 0,
+		0x00,
+		kb->mute_led ? 1 : 0,
+		kb->micmute_led ? 1 : 0
+	};
