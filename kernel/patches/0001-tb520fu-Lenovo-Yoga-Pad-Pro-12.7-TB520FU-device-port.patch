+#define ALGO_VERSION_MAX	(80)
+
+#define AW_GET_MIN_VALUE(value1, value2) \
+	((value1) > (value2) ? (value2) : (value1))
+
+#define AW_GET_MAX_VALUE(value1, value2)  \
+	((value1) > (value2) ? (value1) : (value2))
+
+
+enum {
+	AW_1000_US = 1000,
+	AW_2000_US = 2000,
+	AW_3000_US = 3000,
+	AW_4000_US = 4000,
+	AW_5000_US = 5000,
+	AW_10000_US = 10000,
+	AW_32000_US = 32000,
+	AW_70000_US = 70000,
+	AW_100000_US = 100000,
+};
+
+struct aw_device;
+
+enum {
+	AW_DEV_TYPE_NONE = 0,
+	AW_DEV_TYPE_OK,
+};
+
+enum {
+	AW_EF_AND_CHECK = 0,
+	AW_EF_OR_CHECK,
+};
+
+enum {
+	AW_DEV_CH_PRI_L = 0,
+	AW_DEV_CH_PRI_R = 1,
+	AW_DEV_CH_SEC_L = 2,
+	AW_DEV_CH_SEC_R = 3,
+	AW_DEV_CH_TERT_L = 4,
+	AW_DEV_CH_TERT_R = 5,
+	AW_DEV_CH_QUAT_L = 6,
