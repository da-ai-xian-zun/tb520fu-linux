+		*msg_num = MSG_PARAM_ID_3;
+		break;
+	case AW_DEV_CH_QUAT_R:
+		*msg_num = MSG_PARAM_ID_3;
+		break;
+	default:
+		aw_pr_err("can not find msg num, channel %d ", dev_ch);
+		return -EINVAL;
+	}
+
+	aw_pr_dbg("msg num[%d] ", *msg_num);
+	return 0;
+}
