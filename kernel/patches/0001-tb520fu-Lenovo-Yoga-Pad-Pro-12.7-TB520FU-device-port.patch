+static ssize_t soft_power_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct lenovo_kb_dev *kb = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+
+	if (val) {
+		schedule_work(&kb->power_on_work);
+		return count;
+	}
+
+	cancel_work_sync(&kb->power_on_work);
+	cancel_delayed_work_sync(&kb->restore_work);
+	ret = lenovo_kb_set_soft_power(kb, false);
+	return ret ? ret : count;
+}
