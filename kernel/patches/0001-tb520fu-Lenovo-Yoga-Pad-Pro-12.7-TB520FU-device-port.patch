+/*
+ * Pick the number of slices per line: by pixel rate first (downstream table),
+ * then bump it until the sink's max slice width, per-slice throughput and
+ * supported slice counts are satisfied. The DPU drives DP DSC with two DSC
+ * encoders in merge mode, each handling at most two slices, so the result
+ * must be 2 or 4; with four encoders (4HS merge, high pixel clocks) it must
+ * be 4.
+ */
+static int msm_dp_dsc_pick_slices(const u8 *dsc_dpcd,
+				  const struct drm_display_mode *mode)
+{
+	u32 ppr_mhz = mode->clock / 1000;
+	u32 max_slice_width = drm_dp_dsc_sink_max_slice_width(dsc_dpcd);
+	u32 slice_mask = drm_dp_dsc_sink_slice_count_mask(dsc_dpcd, false);
+	int tput_khz = drm_dp_dsc_sink_max_slice_throughput(dsc_dpcd, mode->clock, true);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(msm_dp_dsc_slice_tbl); i++)
+		if (ppr_mhz > msm_dp_dsc_slice_tbl[i].min_ppr_mhz &&
+		    ppr_mhz <= msm_dp_dsc_slice_tbl[i].max_ppr_mhz)
+			break;
+
+	for (; i < ARRAY_SIZE(msm_dp_dsc_slice_tbl); i++) {
+		u32 n = max_t(u32, msm_dp_dsc_slice_tbl[i].slices, 2);
+
+		if (n > 4)
+			return -EINVAL;
+		/* 4:4:1 (DSC 4HS merge, see MSM_DP_DSC_2LM_MAX_KHZ): one slice per encoder */
+		if (mode->clock > 979047 && n != 4)
+			continue;
+		if (mode->hdisplay % n)
+			continue;
+		if (max_slice_width && mode->hdisplay / n > max_slice_width)
+			continue;
+		if (tput_khz > 0 && mode->clock / n > tput_khz)
+			continue;
+		if (!(slice_mask & drm_dp_dsc_slice_count_to_mask(n)))
+			continue;
+		return n;
+	}
+
+	return -EINVAL;
+}
