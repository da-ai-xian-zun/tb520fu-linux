+static int lenovo_kb_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct lenovo_kb_dev *kb;
+	int ret;
+
+	kb = devm_kzalloc(dev, sizeof(*kb), GFP_KERNEL);
+	if (!kb)
+		return -ENOMEM;
+
+	kb->serdev = serdev;
+	kb->dev = dev;
+	kb->tp_enabled = true;
+	kb->tp_autosleep = true;
+	kb->rx_state = OWB_STATE_WAIT_START_FLAG1;
+	mutex_init(&kb->tx_lock);
+	INIT_WORK(&kb->connect_work, lenovo_kb_connect_work_fn);
+	INIT_DELAYED_WORK(&kb->restore_work, lenovo_kb_restore_work_fn);
+	INIT_WORK(&kb->power_on_work, lenovo_kb_power_on_work_fn);
+	mutex_init(&kb->power_lock);
+	init_completion(&kb->power_ack);
+
+	serdev_device_set_drvdata(serdev, kb);
+
+	/* Acquire GPIOs (supporting both standard and vendor property names) */
+	kb->power_en_gpio = devm_gpiod_get_optional(dev, "power-en", GPIOD_OUT_LOW);
+	if (IS_ERR(kb->power_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(kb->power_en_gpio),
+				     "failed to get power-en-gpios\n");
+
+	kb->tx_en_gpio = devm_gpiod_get_optional(dev, "tx-en", GPIOD_OUT_LOW);
+	if (IS_ERR(kb->tx_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(kb->tx_en_gpio),
+				     "failed to get tx-en-gpios\n");
+
+	/*
+	 * "pupd-gpios" (TLMM 180) is deliberately not used. The vendor device
+	 * tree lists it, but the vendor driver never requests it and on Android
+	 * the pin stays with the sensor island (egpio). Requesting it here takes
+	 * the pin away from the sensor hub and drives it.
+	 */
+
+	kb->plug_gpio = devm_gpiod_get_optional(dev, "plug", GPIOD_IN);
+	if (IS_ERR(kb->plug_gpio))
+		return dev_err_probe(dev, PTR_ERR(kb->plug_gpio),
+				     "failed to get plug-gpios\n");
+
+	kb->uart_wake_gpio = devm_gpiod_get_optional(dev, "uart-wake", GPIOD_IN);
+	if (IS_ERR(kb->uart_wake_gpio))
+		return dev_err_probe(dev, PTR_ERR(kb->uart_wake_gpio),
+				     "failed to get uart-wake-gpios\n");
+
+	kb->lid_gpio = devm_gpiod_get_optional(dev, "lid", GPIOD_IN);
+	if (IS_ERR(kb->lid_gpio))
+		return dev_err_probe(dev, PTR_ERR(kb->lid_gpio),
+				     "failed to get lid-gpios\n");
+
+	ret = lenovo_kb_setup_inputs(kb);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to setup input devices\n");
+
+	serdev_device_set_client_ops(serdev, &lenovo_kb_serdev_ops);
+	ret = devm_serdev_device_open(dev, serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to open serdev UART\n");
+
+	dev_info(dev, "baud %d, actual %u\n", dbg_baud,
+		 serdev_device_set_baudrate(serdev, dbg_baud));
+	serdev_device_set_flow_control(serdev, false);
+	ret = serdev_device_set_parity(serdev, SERDEV_PARITY_NONE);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to configure UART parity\n");
+
+	device_init_wakeup(dev, true);
+
+	if (kb->plug_gpio) {
+		kb->plug_irq = gpiod_to_irq(kb->plug_gpio);
+		if (kb->plug_irq > 0) {
+			ret = devm_request_threaded_irq(dev, kb->plug_irq, NULL,
+							lenovo_kb_plug_irq,
+							IRQF_TRIGGER_RISING |
+							IRQF_TRIGGER_FALLING |
+							IRQF_ONESHOT,
+							"lenovo-kb-plug", kb);
+			if (ret)
+				dev_warn(dev, "failed to request plug irq: %d\n", ret);
+			else
+				enable_irq_wake(kb->plug_irq);
+		}
+	}
+
+	/*
+	 * The wake line follows the keyboard's UART traffic. As in the vendor
+	 * driver it is only armed across system suspend, after the keyboard
+	 * has been put to sleep; see lenovo_kb_suspend().
+	 */
+	if (kb->uart_wake_gpio) {
+		kb->wake_irq = gpiod_to_irq(kb->uart_wake_gpio);
+		if (kb->wake_irq > 0) {
+			/* Drop edges seen while the line is disabled. */
+			irq_set_status_flags(kb->wake_irq, IRQ_DISABLE_UNLAZY);
+			ret = devm_request_threaded_irq(dev, kb->wake_irq, NULL,
+							lenovo_kb_wake_irq,
+							IRQF_TRIGGER_FALLING |
+							IRQF_ONESHOT |
+							IRQF_NO_AUTOEN,
+							"lenovo-kb-wake", kb);
+			if (ret) {
+				dev_warn(dev, "failed to request wake irq: %d\n", ret);
+				kb->wake_irq = 0;
+			}
+		}
+	}
+
+	if (kb->lid_gpio) {
+		kb->lid_irq = gpiod_to_irq(kb->lid_gpio);
+		if (kb->lid_irq > 0) {
+			ret = devm_request_threaded_irq(dev, kb->lid_irq, NULL,
+							lenovo_kb_lid_irq,
+							IRQF_TRIGGER_RISING |
+							IRQF_TRIGGER_FALLING |
+							IRQF_ONESHOT,
+							"lenovo-kb-lid", kb);
+			if (!ret)
+				enable_irq_wake(kb->lid_irq);
+		}
+	}
+
+	/* Trigger initial attach check */
+	schedule_work(&kb->connect_work);
+	return 0;
+}
+
+static void lenovo_kb_remove(struct serdev_device *serdev)
+{
+	struct lenovo_kb_dev *kb = serdev_device_get_drvdata(serdev);
+
+	cancel_work_sync(&kb->connect_work);
+	cancel_work_sync(&kb->power_on_work);
+	cancel_delayed_work_sync(&kb->restore_work);
+
+	if (kb->power_en_gpio)
+		gpiod_set_value_cansleep(kb->power_en_gpio, 0);
+}
+
+static int lenovo_kb_suspend(struct device *dev)
+{
+	struct lenovo_kb_dev *kb = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_work_sync(&kb->power_on_work);
+	cancel_delayed_work_sync(&kb->restore_work);
+	if (!kb->connected)
+		return 0;
+
+	ret = lenovo_kb_set_soft_power(kb, false);
+	lenovo_kb_release_all(kb);
+	if (ret) {
+		/*
+		 * A keyboard that is still awake keeps sending its heartbeat,
+		 * so its wake line must stay off or the system cannot sleep.
+		 * The lid and plug lines can still wake it.
+		 */
+		dev_warn(dev, "keyboard did not go to sleep (%d), wake line left off\n", ret);
+		return 0;
+	}
+	/* Let the line settle after the acknowledgement. */
+	msleep(20);
+
+	if (kb->wake_irq > 0) {
+		enable_irq(kb->wake_irq);
+		enable_irq_wake(kb->wake_irq);
+		kb->wake_armed = true;
+	}
+	return 0;
+}
+
+static int lenovo_kb_resume(struct device *dev)
+{
+	struct lenovo_kb_dev *kb = dev_get_drvdata(dev);
+
+	if (kb->wake_armed) {
+		disable_irq_wake(kb->wake_irq);
+		disable_irq(kb->wake_irq);
+		kb->wake_armed = false;
+	}
+	if (kb->connected)
+		schedule_work(&kb->power_on_work);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(lenovo_kb_pm_ops, lenovo_kb_suspend, lenovo_kb_resume);
+
+static const struct of_device_id lenovo_kb_of_match[] = {
+	{ .compatible = "lenovo,tb520fu-keyboard" },
+	{ .compatible = "lenovo,lenovo_keyboard" },
+	{ .compatible = "lenovo,keyboard-plat" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lenovo_kb_of_match);
+
+static struct serdev_device_driver lenovo_kb_driver = {
+	.probe = lenovo_kb_probe,
+	.remove = lenovo_kb_remove,
+	.driver = {
+		.name = "lenovo-tb520fu-keyboard",
+		.of_match_table = lenovo_kb_of_match,
+		.dev_groups = lenovo_kb_groups,
+		.pm = pm_sleep_ptr(&lenovo_kb_pm_ops),
+	},
+};
+module_serdev_device_driver(lenovo_kb_driver);
+
+MODULE_AUTHOR("TB520FU Mainline Linux Porting Project");
+MODULE_DESCRIPTION("Lenovo Yoga Pad Pro 12.7 (TB520FU) Pogo-Pin Keyboard & Touchpad serdev driver");
+MODULE_LICENSE("GPL");
