diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index b58a607b7..db42050ad 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -2506,6 +2506,26 @@ DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_QCOM, 0x0302, qcom_fixup_class);
 DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_QCOM, 0x1000, qcom_fixup_class);
 DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_QCOM, 0x1001, qcom_fixup_class);
 
+/*
+ * TB520FU: the SM8650 Root Port (17cb:0113) sets HPC in Slot Capabilities,
+ * but its only slot carries the soldered WCN7850. Without pciehp,
+ * pci_bridge_d3_possible() then refuses D3 for the port, so
+ * dw_pcie_suspend_noirq() never powers the controller down and its PHY
+ * reference clock keeps the RPMh XO vote (no CX collapse) in suspend.
+ * Runs before pci_pm_init() computes bridge_d3.
+ */
+static void qcom_fixup_tb520fu_no_hotplug(struct pci_dev *dev)
+{
+	if (IS_ENABLED(CONFIG_HOTPLUG_PCI_PCIE) ||
+	    pci_pcie_type(dev) != PCI_EXP_TYPE_ROOT_PORT ||
+	    !of_machine_is_compatible("lenovo,tb520fu"))
+		return;
+
+	dev->is_hotplug_bridge = 0;
+	dev->is_pciehp = 0;
+}
+DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_QCOM, 0x0113, qcom_fixup_tb520fu_no_hotplug);
+
