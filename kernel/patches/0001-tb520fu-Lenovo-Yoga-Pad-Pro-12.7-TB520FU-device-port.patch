+static void q6apm_compr_work_put(struct q6apm_dai_rtd *prtd, bool *queued)
+{
+	unsigned long flags;
+	bool drop = false;
+
+	spin_lock_irqsave(&prtd->lock, flags);
+	if (*queued) {
+		*queued = false;
+		drop = true;
+	}
+	spin_unlock_irqrestore(&prtd->lock, flags);
+	if (drop)
+		q6apm_dai_rtd_put(prtd);
+}
