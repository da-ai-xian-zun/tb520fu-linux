+	if (ehdr->e_shentsize || ehdr->e_shnum) {
+		if (ehdr->e_shentsize != sizeof(struct elf64_shdr))
+			return false;
+
+		shend = size_add(size_mul(sizeof(struct elf64_shdr), ehdr->e_shnum), ehdr->e_shoff);
+		if (shend > fw->size)
