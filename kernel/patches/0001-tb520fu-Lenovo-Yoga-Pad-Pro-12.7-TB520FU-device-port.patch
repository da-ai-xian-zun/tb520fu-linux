+ */
+static int qcom_battmgr_lenovo_qi_read(struct qcom_battmgr *battmgr, u32 prop,
+				       u32 *val)
+{
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr,
+					    BATTMGR_LENOVO_QI_PROPERTY_GET,
+					    prop, 0);
+	*val = battmgr->lenovo_qi_val;
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
