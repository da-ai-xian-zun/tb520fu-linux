+		aw_dev_err(aw_dev->dev, "unsupport dev channel");
+		return -EINVAL;
+	}
+
+	ret = aw882xx_dsp_read_dsp_msg(aw_dev, msg_id, (char *)data, sizeof(int32_t) * 6);
+	if (ret) {
+		aw_dev_err(aw_dev->dev, "read real re failed ");
+		return ret;
+	}
+
+	*r0 = AW_DSP_RE_TO_SHOW_RE(data[0]);
