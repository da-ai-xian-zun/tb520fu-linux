+/*******************************************************
+Description:
+	Novatek touchscreen parse device tree function.
+
+return:
+	n.a.
+*******************************************************/
+#ifdef CONFIG_OF
+static int32_t nvt_parse_dt(struct device *dev)
+{
+	struct device_node *np = dev->of_node;
+	int32_t ret = 0;
+
+#if NVT_TOUCH_SUPPORT_HW_RST
+	ts->reset_gpiod = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ts->reset_gpiod))
+		return PTR_ERR(ts->reset_gpiod);
+	if (!ts->reset_gpiod) {
+		ts->reset_gpiod = devm_fwnode_gpiod_get_index(dev, of_fwnode_handle(np),
+						    "novatek,reset", 0,
+						    GPIOD_OUT_LOW, "NVT-tp-rst");
+		if (IS_ERR(ts->reset_gpiod))
+			return PTR_ERR(ts->reset_gpiod);
+	}
+	ts->reset_gpio = desc_to_gpio(ts->reset_gpiod);
+	NVT_LOG("reset-gpio=%d\n", ts->reset_gpio);
+#endif
+	ts->irq_gpiod = devm_gpiod_get_optional(dev, "irq", GPIOD_IN);
+	if (IS_ERR(ts->irq_gpiod))
+		return PTR_ERR(ts->irq_gpiod);
+	if (!ts->irq_gpiod) {
+		ts->irq_gpiod = devm_fwnode_gpiod_get_index(dev, of_fwnode_handle(np),
+					      "novatek,irq", 0, GPIOD_IN,
+					      "NVT-int");
+		if (IS_ERR(ts->irq_gpiod))
+			return PTR_ERR(ts->irq_gpiod);
+	}
+	ts->irq_gpio = desc_to_gpio(ts->irq_gpiod);
+	NVT_LOG("irq-gpio=%d\n", ts->irq_gpio);
+
+	ts->is_nt36532 = of_device_is_compatible(np, "lenovo,tb520fu-nt36532-spi") ||
+			 of_device_is_compatible(np, "novatek,nt36532-spi");
+
+	ts->pen_support = of_property_read_bool(np, "novatek,pen-support");
+	NVT_LOG("novatek,pen-support=%d is_nt36532=%d\n", ts->pen_support, ts->is_nt36532);
+
+	ts->wgp_stylus = of_property_read_bool(np, "novatek,wgp-stylus");
+	NVT_LOG("novatek,wgp-stylus=%d\n", ts->wgp_stylus);
+
+	ret = of_property_read_u32(np, "novatek,swrst-n8-addr", &SWRST_N8_ADDR);
+	if (ret) {
+		SWRST_N8_ADDR = ts->is_nt36532 ? 0x1FB43E : 0x03F0FE;
+		NVT_LOG("using default SWRST_N8_ADDR=0x%06X\n", SWRST_N8_ADDR);
+		ret = 0;
+	} else if (ts->is_nt36532 && SWRST_N8_ADDR != 0x1FB43E) {
+		/*
+		 * The software reset register is a property of the chip, not
+		 * of the board.  NT36532 has it at 0x1FB43E; 0x03F0FE is the
+		 * NT36523 address and leaves the MCU running, so a firmware
+		 * reload without a panel reset (ESD/WDT recovery) fails.
+		 */
+		NVT_ERR("ignoring novatek,swrst-n8-addr=0x%06X for NT36532, using 0x1FB43E\n",
+			SWRST_N8_ADDR);
+		SWRST_N8_ADDR = 0x1FB43E;
+	} else {
+		NVT_LOG("SWRST_N8_ADDR=0x%06X\n", SWRST_N8_ADDR);
+	}
+
+	ret = of_property_read_u32(np, "novatek,spi-rd-fast-addr", &SPI_RD_FAST_ADDR);
+	if (ret) {
+		SPI_RD_FAST_ADDR = ts->is_nt36532 ? 0 : 0x03F310;
+		NVT_LOG("using default SPI_RD_FAST_ADDR=0x%06X\n", SPI_RD_FAST_ADDR);
+		ret = 0;
+	} else {
+		NVT_LOG("SPI_RD_FAST_ADDR=0x%06X\n", SPI_RD_FAST_ADDR);
+	}
+
+	ret = of_property_read_string(np, "firmware-name", &ts->fw_name);
+	if (ret) {
+		NVT_LOG("Unable to get touchscreen firmware name\n");
+		ts->fw_name = DEFAULT_BOOT_UPDATE_FIRMWARE_NAME;
+	}
+
+	ret = of_property_read_u32(np, "spi-max-frequency", &ts->spi_max_freq);
+	if (ret) {
+		NVT_LOG("Unable to get spi freq\n");
+		return ret;
+	} else {
+		NVT_LOG("spi-max-frequency: %u\n", ts->spi_max_freq);
+	}
+
+	if (of_property_read_u32(np, "touchscreen-size-x", &ts->raw_x_max))
+		ts->raw_x_max = TOUCH_DEFAULT_MAX_WIDTH;
+	if (of_property_read_u32(np, "touchscreen-size-y", &ts->raw_y_max))
+		ts->raw_y_max = TOUCH_DEFAULT_MAX_HEIGHT;
+	ts->swap_xy = of_property_read_bool(np, "touchscreen-swapped-x-y");
+	ts->invert_x = of_property_read_bool(np, "touchscreen-inverted-x");
+	ts->invert_y = of_property_read_bool(np, "touchscreen-inverted-y");
+	nvt_apply_android16_range();
+	NVT_LOG("touch raw=%ux%u swap=%d invx=%d invy=%d\n",
+		ts->raw_x_max, ts->raw_y_max, ts->swap_xy, ts->invert_x, ts->invert_y);
+
+	return ret;
+}
+#else
+static int32_t nvt_parse_dt(struct device *dev)
+{
+#if NVT_TOUCH_SUPPORT_HW_RST
+	ts->reset_gpio = NVTTOUCH_RST_PIN;
+#endif
+	ts->irq_gpio = NVTTOUCH_INT_PIN;
+	return 0;
+}
+#endif
