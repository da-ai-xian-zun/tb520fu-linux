+	aw882xx->codec_ops = &aw_componet_codec_ops;
+	aw882xx->fw_status = AW_DEV_FW_FAILED;
+	aw882xx->fw_retry_cnt = 0;
+	aw882xx->dbg_en_prof = true;
+	aw882xx->allow_pw = true;
+	aw882xx->work_queue = NULL;
+
+	mutex_init(&aw882xx->lock);
+
+	return aw882xx;
