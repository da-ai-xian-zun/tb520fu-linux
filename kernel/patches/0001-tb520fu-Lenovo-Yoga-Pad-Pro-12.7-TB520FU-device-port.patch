+	lease = kzalloc_obj(*lease);
+	if (!lease)
+		return NULL;
+	lease->apm = apm;
+	lease->graph_id = graph_id;
+	lease->generation = generation;
+	lease->state = AUDIOREACH_MEM_UNMAPPED;
+	kref_init(&lease->refcount);
+	kref_get(&apm->refcount);
