+
+/*
+ * Software power: the vendor driver sends this when the panel turns off and
+ * on. The data byte is inverted: 1 puts the MCU to sleep, 0 wakes it. A
+ * sleeping keyboard stops the once-a-second heartbeat, which would otherwise
+ * pull the wake line and end every system suspend within a fraction of a
+ * second.
+ *
+ * The MCU answers 6b 03 36 01 <same byte>. A keyboard that has been asleep for
+ * a while only wakes up on the first frame and does not act on it, so the
+ * command is repeated until it is acknowledged, as the vendor driver does.
+ */
+static int lenovo_kb_set_soft_power(struct lenovo_kb_dev *kb, bool on)
+{
+	const u8 cmd[] = { 0x6a, 0x03, 0x36, 0x01, on ? 0 : 1 };
+	int try, ret = -ETIMEDOUT;
+
+	mutex_lock(&kb->power_lock);
+	WRITE_ONCE(kb->soft_off, !on);
+	for (try = 0; try < 4; try++) {
+		reinit_completion(&kb->power_ack);
+		ret = lenovo_kb_send_cmd(kb, cmd, sizeof(cmd));
+		if (ret)
+			break;
+		if (wait_for_completion_timeout(&kb->power_ack, msecs_to_jiffies(100)) &&
+		    kb->power_ack_val == cmd[4])
+			break;
+		ret = -ETIMEDOUT;
+	}
+	mutex_unlock(&kb->power_lock);
+	return ret;
+}
+
+/*
+ * Standard 8-byte USB HID Boot Keyboard report handler (Report 0x11)
+ *   data[0]: Modifier bitmask (LCTRL..RMETA)
+ *   data[1]: Reserved
+ *   data[2..7]: Up to 6 simultaneous HID Usage IDs
+ */
+static void lenovo_kb_report_keys(struct lenovo_kb_dev *kb, const u8 *data)
+{
+	u8 changed_mods = kb->old_kb_report[0] ^ data[0];
+	int i, j;
+
+	/* 1. Modifier keys */
+	if (changed_mods) {
+		for (i = 0; i < 8; i++) {
+			if (changed_mods & BIT(i)) {
+				input_report_key(kb->kb_input,
+						 lenovo_modifier_sc[i],
+						 !!(data[0] & BIT(i)));
+			}
+		}
+	}
+
+	/* 2. Released normal keys (in old_kb_report[2..7] but not in data[2..7]) */
+	for (i = 2; i < 8; i++) {
+		u8 old_hid = kb->old_kb_report[i];
+		bool still_pressed = false;
+
+		if (!old_hid)
+			continue;
+
+		for (j = 2; j < 8; j++) {
+			if (data[j] == old_hid) {
+				still_pressed = true;
+				break;
+			}
+		}
+
+		if (!still_pressed && lenovo_hid_to_sc[old_hid]) {
+			input_report_key(kb->kb_input,
+					 lenovo_hid_to_sc[old_hid], 0);
+		}
+	}
+
+	/* 3. Newly pressed normal keys (in data[2..7] but not in old_kb_report[2..7]) */
+	for (i = 2; i < 8; i++) {
+		u8 new_hid = data[i];
+		bool was_pressed = false;
+
+		if (!new_hid)
+			continue;
+
+		for (j = 2; j < 8; j++) {
+			if (kb->old_kb_report[j] == new_hid) {
+				was_pressed = true;
+				break;
+			}
+		}
+
+		if (!was_pressed && lenovo_hid_to_sc[new_hid]) {
+			input_report_key(kb->kb_input,
+					 lenovo_hid_to_sc[new_hid], 1);
+		}
+	}
+
+	input_sync(kb->kb_input);
+	memcpy(kb->old_kb_report, data, 8);
+}
+
+static u16 lenovo_lookup_custom_key(u16 usage)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(lenovo_custom_keys); i++) {
+		if (lenovo_custom_keys[i].raw_usage == usage) {
+			return fn_media_keys ?
+				lenovo_custom_keys[i].linux_sc :
+				lenovo_custom_keys[i].android_sc;
+		}
+	}
+	return KEY_UNKNOWN;
+}
+
+/*
+ * Consumer / Fn Hotkey report handler (Report 0x12)
+ *   data[0..1]: Slot 0 16-bit LE usage
+ *   data[2..3]: Slot 1 16-bit LE usage
+ */
+static void lenovo_kb_report_custom(struct lenovo_kb_dev *kb, const u8 *data)
+{
+	u16 old_u[2], new_u[2];
+	int i, j;
+
+	old_u[0] = get_unaligned_le16(&kb->old_cus_report[0]);
+	old_u[1] = get_unaligned_le16(&kb->old_cus_report[2]);
+	new_u[0] = get_unaligned_le16(&data[0]);
+	new_u[1] = get_unaligned_le16(&data[2]);
+
+	/* Check released custom keys */
+	for (i = 0; i < 2; i++) {
+		bool still_down = false;
+		u16 sc;
+
+		if (!old_u[i])
+			continue;
+		for (j = 0; j < 2; j++) {
+			if (new_u[j] == old_u[i]) {
+				still_down = true;
+				break;
+			}
+		}
+		if (!still_down) {
+			sc = lenovo_lookup_custom_key(old_u[i]);
+			input_event(kb->kb_input, EV_MSC, MSC_SCAN, old_u[i]);
+			input_report_key(kb->kb_input, sc, 0);
+		}
+	}
+
+	/* Check pressed custom keys */
+	for (i = 0; i < 2; i++) {
+		bool was_down = false;
+		u16 sc;
+
+		if (!new_u[i])
+			continue;
+		for (j = 0; j < 2; j++) {
+			if (old_u[j] == new_u[i]) {
+				was_down = true;
+				break;
+			}
+		}
+		if (!was_down) {
+			sc = lenovo_lookup_custom_key(new_u[i]);
+			input_event(kb->kb_input, EV_MSC, MSC_SCAN, new_u[i]);
+			input_report_key(kb->kb_input, sc, 1);
+		}
+	}
+
+	input_sync(kb->kb_input);
+	memcpy(kb->old_cus_report, data, 4);
+}
+
+/*
+ * Multi-Touch Type B Touchpad report handler (Report 0x13)
+ *   p[0] = byte count (2 + 5 * N_fingers)
+ *   p[1] = button mask (bit0 = BTN_LEFT, bit1 = BTN_RIGHT)
+ *   p[2 + 5*i .. 6 + 5*i] = 5-byte finger record:
+ *     rec[0]: upper nibble = slot (0..3), bit0 = is_down
+ *     rec[1..2]: LE16 X coordinate (0..3211)
+ *     rec[3..4]: LE16 Y coordinate (0..1879)
+ */
+static void lenovo_kb_report_touchpad(struct lenovo_kb_dev *kb,
+				      const u8 *p, size_t max_len)
+{
+	u8 pkt_len;
+	u8 buttons;
+	int num_records, i;
+
+	if (max_len < 2)
+		return;
+
+	pkt_len = p[0];
+	if (pkt_len < 2 || pkt_len > max_len)
+		return;
+
+	buttons = p[1];
+	/* pkt_len counts the button byte and the 5-byte finger records. */
+	num_records = (pkt_len - 1) / 5;
+
+	for (i = 0; i < num_records; i++) {
+		const u8 *rec = &p[2 + i * 5];
+		unsigned int slot = (rec[0] >> 4) & 0x0f;
+		bool is_down = !!(rec[0] & 0x01);
+		u16 x = get_unaligned_le16(&rec[1]);
+		u16 y = get_unaligned_le16(&rec[3]);
+
+		if (slot >= LENOVO_TP_MAX_SLOTS)
+			continue;
+
+		input_mt_slot(kb->tp_input, slot);
+		input_mt_report_slot_state(kb->tp_input, MT_TOOL_FINGER, is_down);
+
+		if (is_down) {
+			if (x > LENOVO_TP_MAX_X)
+				x = LENOVO_TP_MAX_X;
+			if (y > LENOVO_TP_MAX_Y)
+				y = LENOVO_TP_MAX_Y;
+			input_report_abs(kb->tp_input, ABS_MT_POSITION_X, x);
+			input_report_abs(kb->tp_input, ABS_MT_POSITION_Y, y);
+			kb->active_slots |= BIT(slot);
+		} else {
+			kb->active_slots &= ~BIT(slot);
+		}
+	}
+
+	/* A clickpad has one physical button; libinput derives right click. */
+	input_report_key(kb->tp_input, BTN_LEFT, !!(buttons & 0x03));
+	input_mt_sync_frame(kb->tp_input);
+	input_sync(kb->tp_input);
+}
+
+/*
+ * Tablet mode: no keyboard attached, or the keyboard is folded behind the
+ * tablet. The keyboard also reports "folded" just before the lid closes;
+ * that is harmless, SW_LID follows and the keyboard reports the typing
+ * posture again when it is woken after the lid opens.
+ */
+static void lenovo_kb_report_tablet_mode(struct lenovo_kb_dev *kb)
+{
+	if (!kb->lid_input)
+		return;
+
+	input_report_switch(kb->lid_input, SW_TABLET_MODE,
+			    !kb->connected || kb->folded);
+	input_sync(kb->lid_input);
+}
+
+/*
+ * Release all currently pressed keys and touch slots (e.g., on physical unplug)
+ */
+static void lenovo_kb_release_all(struct lenovo_kb_dev *kb)
+{
+	int i;
+
+	for (i = 0; i < 8; i++)
+		input_report_key(kb->kb_input, lenovo_modifier_sc[i], 0);
+
+	for (i = 2; i < 8; i++) {
+		u8 hid = kb->old_kb_report[i];
+
+		if (hid && lenovo_hid_to_sc[hid])
+			input_report_key(kb->kb_input, lenovo_hid_to_sc[hid], 0);
+	}
+	memset(kb->old_kb_report, 0, sizeof(kb->old_kb_report));
+	memset(kb->old_cus_report, 0, sizeof(kb->old_cus_report));
+	input_sync(kb->kb_input);
+
+	for (i = 0; i < LENOVO_TP_MAX_SLOTS; i++) {
+		input_mt_slot(kb->tp_input, i);
+		input_mt_report_slot_state(kb->tp_input, MT_TOOL_FINGER, false);
+	}
+	kb->active_slots = 0;
+	input_report_key(kb->tp_input, BTN_LEFT, 0);
+	input_mt_sync_frame(kb->tp_input);
+	input_sync(kb->tp_input);
+}
+
+/*
+ * Process a complete unstuffed PPP frame:
+ *   frame[0]        = seed
+ *   frame[1..len-2] = scrambled payload
+ *   frame[len-1]    = scrambled checksum
+ */
+static void lenovo_kb_handle_frame(struct lenovo_kb_dev *kb, u8 *frame, size_t len)
+{
+	u8 seed;
+	u8 *payload;
+	size_t payload_len;
+	u8 expected_csum;
+
+	if (len < 3)
+		return;
+
+	seed = frame[0];
+	/* The checksum is taken over the bytes as received, before descrambling. */
+	expected_csum = lenovo_calc_checksum(frame, len - 1);
+
+	payload = &frame[1];
+	payload_len = len - 2;
+	if (expected_csum != frame[len - 1]) {
+		dev_dbg(kb->dev, "checksum mismatch: calc=0x%02x pkt=0x%02x\n",
+			expected_csum, frame[len - 1]);
+		return;
+	}
+
+	lenovo_disscram(seed, payload, payload_len);
+
+	switch (payload[0]) {
+	case REPORT_KEYBOARD:
+		/* payload[1] is a length byte; the HID boot report follows it. */
+		if (payload_len >= 10)
+			lenovo_kb_report_keys(kb, &payload[2]);
+		break;
+
+	case REPORT_CUSTOM_KEY:
+		/* payload[1] is a length byte, as in the keyboard report. */
+		if (payload_len >= 6)
+			lenovo_kb_report_custom(kb, &payload[2]);
+		break;
+
+	case REPORT_TOUCHPAD:
+		if (payload_len >= 3)
+			lenovo_kb_report_touchpad(kb, &payload[1], payload_len - 1);
+		break;
+
+	case REPORT_POSTURE:
+		/*
+		 * The vendor driver turns this into KEYBOARD_REVERSE (0x28f)
+		 * and KEYBOARD_RESTORE (0x28e). It is the keyboard's posture,
+		 * not a touchpad switch.
+		 */
+		if (payload_len >= 5) {
+			kb->folded = !payload[4];
+			dev_dbg(kb->dev, "posture: %s\n",
+				kb->folded ? "folded back" : "typing");
+			lenovo_kb_report_tablet_mode(kb);
+		}
+		break;
+
+	case REPORT_ATTACH_INIT:
+		/*
+		 * Sent about once a second, not only at power-on. The last byte
+		 * mirrors the LEDs (bit 0 caps, bit 2 mute), so restore only when
+		 * the MCU has lost them instead of flooding the one-wire bus.
+		 */
+		if (payload_len >= 6) {
+			u8 want = (kb->caps_led ? 0x01 : 0) | (kb->mute_led ? 0x04 : 0);
+
+			if ((payload[5] & 0x05) == want)
+				break;
+		}
+		/* Do not talk to a keyboard that was just put to sleep. */
+		if (READ_ONCE(kb->soft_off))
+			break;
+		WRITE_ONCE(kb->led_only, false);
+		schedule_delayed_work(&kb->restore_work, msecs_to_jiffies(30));
+		break;
+
+	case REPORT_CMD_ACK_6B:
+		if (payload_len >= 5 && payload[2] == 0x36) {
+			kb->power_ack_val = payload[4];
+			complete(&kb->power_ack);
+			break;
+		}
+		fallthrough;
+	case REPORT_CMD_ACK_6A:
+	case REPORT_CMD_ACK_70:
+	case REPORT_CMD_ACK_71:
+	case REPORT_CMD_ACK_83:
+		if (payload_len >= 6 && payload[2] == 0x20)
+			memcpy(kb->kb_version, &payload[3],
+			       min_t(size_t, payload_len - 3, sizeof(kb->kb_version)));
+		break;
+
+	default:
+		dev_dbg(kb->dev, "unknown report 0x%02x (len=%zu)\n",
+			payload[0], payload_len);
+		break;
+	}
+}
+
+/*
+ * Streaming PPP byte-unstuffing state machine (called from serdev receive_buf)
+ */
+static size_t lenovo_kb_receive_buf(struct serdev_device *serdev,
+				    const u8 *buf, size_t count)
+{
+	struct lenovo_kb_dev *kb = serdev_device_get_drvdata(serdev);
+	size_t i;
+
+	if (dbg_raw)
+		dev_info(kb->dev, "rx %zu: %*ph\n", count, (int)min_t(size_t, count, 48), buf);
+
+	for (i = 0; i < count; i++) {
+		u8 b = buf[i];
+
+		switch (kb->rx_state) {
+		case OWB_STATE_WAIT_START_FLAG1:
+			if (b == PPP_FLAG_BYTE)
+				kb->rx_state = OWB_STATE_WAIT_START_FLAG2;
+			break;
+
+		case OWB_STATE_WAIT_START_FLAG2:
+			if (b == PPP_ADDR_BYTE) {
+				kb->rx_len = 0;
+				kb->rx_escaped = false;
+				kb->rx_state = OWB_STATE_WAIT_END_FLAG;
+			} else if (b != PPP_FLAG_BYTE) {
+				kb->rx_state = OWB_STATE_WAIT_START_FLAG1;
+			}
+			break;
+
+		case OWB_STATE_WAIT_END_FLAG:
+			if (b == PPP_FLAG_BYTE) {
+				if (kb->rx_len >= 3)
+					lenovo_kb_handle_frame(kb, kb->rx_frame,
+							       kb->rx_len);
+				kb->rx_len = 0;
+				kb->rx_escaped = false;
+				kb->rx_state = OWB_STATE_WAIT_START_FLAG1;
+			} else if (b == PPP_ESC_BYTE) {
+				kb->rx_escaped = true;
+			} else {
+				if (kb->rx_escaped) {
+					b ^= PPP_ESC_XOR;
+					kb->rx_escaped = false;
+				}
+				if (kb->rx_len < sizeof(kb->rx_frame)) {
+					kb->rx_frame[kb->rx_len++] = b;
+				} else {
+					/* Frame overflow: reset state machine */
+					kb->rx_len = 0;
+					kb->rx_state = OWB_STATE_WAIT_START_FLAG1;
+				}
+			}
+			break;
+		}
+	}
+
+	return count;
+}
+
+static const struct serdev_device_ops lenovo_kb_serdev_ops = {
+	.receive_buf = lenovo_kb_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+/*
+ * Input EV_LED callback (triggered by X11/Wayland CapsLock / Mute LED changes)
+ */
+static int lenovo_kb_input_event(struct input_dev *dev, unsigned int type,
+				 unsigned int code, int value)
+{
+	struct lenovo_kb_dev *kb = input_get_drvdata(dev);
+
+	if (type != EV_LED)
+		return -1;
+
+	switch (code) {
+	case LED_CAPSL:
+		kb->caps_led = !!value;
+		WRITE_ONCE(kb->led_only, true);
+		schedule_delayed_work(&kb->restore_work, 0);
+		return 0;
+	case LED_MUTE:
+		kb->mute_led = !!value;
+		WRITE_ONCE(kb->led_only, true);
+		schedule_delayed_work(&kb->restore_work, 0);
+		return 0;
+	case LED_MISC:
+		kb->micmute_led = !!value;
+		WRITE_ONCE(kb->led_only, true);
+		schedule_delayed_work(&kb->restore_work, 0);
+		return 0;
+	default:
+		return -1;
+	}
+}
+
+static void lenovo_kb_restore_work_fn(struct work_struct *work)
+{
+	struct lenovo_kb_dev *kb =
+		container_of(to_delayed_work(work), struct lenovo_kb_dev, restore_work);
+
+	if (!kb->connected || READ_ONCE(kb->soft_off))
+		return;
+
+	/*
+	 * The restore command (0x2b) does not visibly change the LEDs on a
+	 * running keyboard (measured on video), so use the per-LED commands.
+	 */
+	if (READ_ONCE(kb->led_only)) {
+		WRITE_ONCE(kb->led_only, false);
+		if (kb->sent_caps != kb->caps_led)
+			lenovo_kb_set_caps_led(kb, kb->caps_led);
+		if (kb->sent_mute != kb->mute_led)
+			lenovo_kb_set_mute_led(kb, kb->mute_led);
+		if (kb->sent_micmute != kb->micmute_led)
+			lenovo_kb_set_micmute_led(kb, kb->micmute_led);
+		return;
+	}
+	lenovo_kb_restore_leds(kb);
+	lenovo_kb_set_tp_enable(kb, kb->tp_enabled);
+	lenovo_kb_set_tp_autosleep(kb, kb->tp_autosleep);
+}
+
+/*
+ * Wake a keyboard that was put to sleep, then restore its state. If it does
+ * not answer at all, cut its supply for a moment so that it starts afresh.
+ */
+static void lenovo_kb_power_on_work_fn(struct work_struct *work)
+{
+	struct lenovo_kb_dev *kb =
+		container_of(work, struct lenovo_kb_dev, power_on_work);
+	int ret;
+
+	if (!kb->connected)
+		return;
+
+	ret = lenovo_kb_set_soft_power(kb, true);
+	if (ret == -ETIMEDOUT && kb->power_en_gpio) {
+		dev_warn(kb->dev, "keyboard did not wake up, cycling its power\n");
+		gpiod_set_value_cansleep(kb->power_en_gpio, 0);
+		msleep(100);
+		gpiod_set_value_cansleep(kb->power_en_gpio, 1);
+		msleep(120);
+	}
+	WRITE_ONCE(kb->led_only, false);
+	schedule_delayed_work(&kb->restore_work, msecs_to_jiffies(30));
+}
+
+static void lenovo_kb_connect_work_fn(struct work_struct *work)
+{
+	struct lenovo_kb_dev *kb =
+		container_of(work, struct lenovo_kb_dev, connect_work);
+	bool plugged = true;
+
+	if (kb->plug_gpio) {
+		/*
+		 * Note: In hardware, plug_gpio (TLMM 198) is pulled LOW when
+		 * the Pogo-Pin keyboard is magnetically attached.
+		 */
+		plugged = (gpiod_get_raw_value_cansleep(kb->plug_gpio) == 0);
+	}
+
+	if (plugged && !kb->connected) {
+		dev_info(kb->dev, "Pogo-Pin keyboard attached, enabling VBUS power\n");
+		if (kb->tx_en_gpio)
+			gpiod_set_value_cansleep(kb->tx_en_gpio, 0);
+		if (kb->power_en_gpio)
+			gpiod_set_value_cansleep(kb->power_en_gpio, 1);
+
+		kb->connected = true;
+		kb->folded = false;
+		WRITE_ONCE(kb->soft_off, false);
+		WRITE_ONCE(kb->led_only, false);
+		/*
+		 * A keyboard attached after boot comes up on VBUS sending only
+		 * its heartbeat, no key or touchpad reports, until it is told to
+		 * power on (seen 2026-11-13). Give the MCU time to boot, then
+		 * run the full wake sequence, which also restores LEDs/touchpad.
+		 */
+		msleep(120);
+		schedule_work(&kb->power_on_work);
+	} else if (!plugged && kb->connected) {
+		dev_info(kb->dev, "Pogo-Pin keyboard detached, disabling VBUS power\n");
+		kb->connected = false;
+		cancel_delayed_work_sync(&kb->restore_work);
+
+		if (kb->power_en_gpio)
+			gpiod_set_value_cansleep(kb->power_en_gpio, 0);
+
+		lenovo_kb_release_all(kb);
+	}
+
+	/* Also sets the initial state when booting without a keyboard. */
+	lenovo_kb_report_tablet_mode(kb);
+}
+
+static irqreturn_t lenovo_kb_plug_irq(int irq, void *data)
+{
+	struct lenovo_kb_dev *kb = data;
+
+	pm_wakeup_event(kb->dev, 500);
+	schedule_work(&kb->connect_work);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t lenovo_kb_wake_irq(int irq, void *data)
+{
+	struct lenovo_kb_dev *kb = data;
+
+	pm_wakeup_event(kb->dev, 500);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t lenovo_kb_lid_irq(int irq, void *data)
+{
+	struct lenovo_kb_dev *kb = data;
+	int lid_closed;
+
+	if (!kb->lid_gpio || !kb->lid_input)
+		return IRQ_HANDLED;
+
+	/* Raw value 0 on GPIO 200 means magnetic cover is closed */
+	lid_closed = (gpiod_get_raw_value_cansleep(kb->lid_gpio) == 0);
+	input_report_switch(kb->lid_input, SW_LID, lid_closed);
+	input_sync(kb->lid_input);
+	pm_wakeup_event(kb->dev, 500);
+	return IRQ_HANDLED;
+}
