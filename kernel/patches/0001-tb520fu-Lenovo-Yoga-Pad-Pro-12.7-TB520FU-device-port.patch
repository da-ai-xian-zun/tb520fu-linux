 /**
  * qcomtee_msg_buffers_alloc() - Allocate inbound and outbound buffers.
@@ -114,14 +119,85 @@ static int qcomtee_shm_unregister(struct tee_context *ctx, struct tee_shm *shm)
 	return 0;
 }
 
+/*
+ * Allocating more than MAX_PAGE_ORDER pages fails in alloc_pages_exact(),
+ * which caps the dynamic helper at 4 MB on this kernel. Large TA images
+ * (e.g. Goodix goodixfp64, ~11.7 MB) need physically contiguous memory for
+ * the SHM bridge, so serve them from the default CMA area instead.
+ */
+static int pool_op_alloc_cma(struct tee_shm *shm, size_t size, size_t align)
+{
+	struct cma *cma = dma_contiguous_get_area_by_idx(0);
+	size_t nr_pages = roundup(size, PAGE_SIZE) / PAGE_SIZE;
+	unsigned int cma_align = align ? get_order(align) : 0;
+	struct page *page;
+	size_t i;
+	int err;
+
+	if (!cma)
+		return -ENOMEM;
+
+	page = cma_alloc(cma, nr_pages, min(cma_align, (unsigned int)CONFIG_CMA_ALIGNMENT),
+			 GFP_KERNEL);
+	if (!page)
+		return -ENOMEM;
+
+	shm->kaddr = page_address(page);
+	shm->paddr = page_to_phys(page);
+	shm->size = nr_pages * PAGE_SIZE;
+
+	shm->pages = kcalloc(nr_pages, sizeof(*shm->pages), GFP_KERNEL);
+	if (!shm->pages) {
+		err = -ENOMEM;
+		goto err_release;
+	}
+
+	for (i = 0; i < nr_pages; i++)
+		shm->pages[i] = page + i;
+
+	shm->num_pages = nr_pages;
+	shm->flags |= QCOMTEE_SHM_CMA;
+
+	err = qcomtee_shm_register(shm->ctx, shm, shm->pages, nr_pages,
+				   (unsigned long)shm->kaddr);
+	if (err)
+		goto err_free_pages;
+
+	return 0;
+
+err_free_pages:
+	shm->flags &= ~QCOMTEE_SHM_CMA;
+	kfree(shm->pages);
+	shm->pages = NULL;
+err_release:
+	cma_release(cma, page, nr_pages);
+	shm->kaddr = NULL;
+
+	return err;
+}
+
 static int pool_op_alloc(struct tee_shm_pool *pool, struct tee_shm *shm,
 			 size_t size, size_t align)
 {
+	if (size > (PAGE_SIZE << MAX_PAGE_ORDER))
+		return pool_op_alloc_cma(shm, size, align);
+
 	return tee_dyn_shm_alloc_helper(shm, size, align, qcomtee_shm_register);
 }
 
 static void pool_op_free(struct tee_shm_pool *pool, struct tee_shm *shm)
 {
+	if (shm->flags & QCOMTEE_SHM_CMA) {
+		qcomtee_shm_unregister(shm->ctx, shm);
+		kfree(shm->pages);
+		shm->pages = NULL;
+		cma_release(dma_contiguous_get_area_by_idx(0),
+			    phys_to_page(shm->paddr), shm->num_pages);
+		shm->kaddr = NULL;
+
+		return;
+	}
+
 	tee_dyn_shm_free_helper(shm, qcomtee_shm_unregister);
 }
 
diff --git a/drivers/tee/qseecom/Kconfig b/drivers/tee/qseecom/Kconfig
new file mode 100644
index 000000000..3e29a095e
--- /dev/null
+++ b/drivers/tee/qseecom/Kconfig
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Qualcomm QSEECOM TEE driver
+config TEE_QSEECOM
+	tristate "Qualcomm QSEECOM TEE driver"
+	depends on QCOM_QSEECOM
+	depends on !CPU_BIG_ENDIAN
+	depends on QCOM_MDT_LOADER
+	help
+	  This exposes QSEE applications reached over the legacy QSEECOM
+	  interface through the TEE subsystem, so that user space can open a
+	  session to a trusted application and invoke commands in it.
+
+	  This is the command-based Qualcomm interface, as distinct from the
+	  object-based smcinvoke interface served by the QCOMTEE driver. The
+	  two are not alternative routes to the same applications: a trusted
+	  application is built against one or the other, so what a system needs
+	  is decided by the applications in its firmware rather than by the age
+	  of its SoC. Platforms offering both interfaces are common, and may
+	  still carry applications that answer only over QSEECOM.
+
+	  Say Y if the firmware carries such applications. See
+	  Documentation/tee/qseecom.rst.
+
+	  Note that the driver cannot validate what a command means, because it
+	  does not know any application's payload format: anyone who can open
+	  the client device may send arbitrary commands to any loaded trusted
+	  application. Restrict access to the device nodes accordingly. See
+	  Documentation/tee/qseecom.rst.
