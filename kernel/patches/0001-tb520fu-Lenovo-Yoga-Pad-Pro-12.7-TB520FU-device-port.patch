+	mutex_lock(&g_apm_lock);
+	candidate = dev_get_drvdata(dev->parent);
+	if (candidate && candidate == g_apm &&
+	    kref_get_unless_zero(&candidate->refcount))
+		apm = candidate;
+	mutex_unlock(&g_apm_lock);
+
+	return apm;
+}
