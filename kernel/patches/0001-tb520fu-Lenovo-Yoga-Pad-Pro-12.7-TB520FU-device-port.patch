+
+#if defined(CONFIG_DRM_PANEL)
+static int nt36xxx_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct nvt_ts_data *ts = container_of(follower, struct nvt_ts_data,
+					      panel_follower);
+	if (READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	mutex_lock(&nvt_follower_lock);
+	ts->panel_on = true;
+
+	if (ts->event_wq) {
+		flush_workqueue(ts->event_wq);
+		queue_work(ts->event_wq, &ts->resume_work);
+	}
+	mutex_unlock(&nvt_follower_lock);
+
+	return 0;
+}
+
+static int nt36xxx_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct nvt_ts_data *ts = container_of(follower, struct nvt_ts_data,
+					      panel_follower);
+	if (READ_ONCE(nvt_removing))
+		return -ENODEV;
+
+	mutex_lock(&nvt_follower_lock);
+	ts->panel_on = false;
+	mutex_unlock(&nvt_follower_lock);
+
+	/* Finish a firmware load before the panel loses power / re-inits. */
+	if (ts->event_wq)
+		flush_workqueue(ts->event_wq);
+
+	return nvt_ts_suspend(&ts->client->dev);
+}
+
+static struct drm_panel_follower_funcs nt36xxx_panel_follower_funcs = {
+	.panel_prepared = nt36xxx_panel_prepared,
+	.panel_unpreparing = nt36xxx_panel_unpreparing,
+};
+#endif
