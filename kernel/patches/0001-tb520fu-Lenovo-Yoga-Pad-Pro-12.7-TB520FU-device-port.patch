+ * Returns 30 or 24 depending on what the sink's DSC decoder accepts, or 0.
+ */
+u32 msm_dp_panel_dsc_max_src_bpp(struct msm_dp_panel *msm_dp_panel, u32 want_bpp)
+{
+	u8 depth = msm_dp_panel->dsc_dpcd[DP_DSC_DEC_COLOR_DEPTH_CAP - DP_DSC_SUPPORT];
+
+	if (want_bpp >= 30 && (depth & DP_DSC_10_BPC))
+		return 30;
+	if (depth & DP_DSC_8_BPC)
+		return 24;
+	return 0;
+}
+
+int msm_dp_panel_dsc_compute(struct msm_dp_panel *msm_dp_panel,
+			     const struct drm_display_mode *mode,
+			     u32 src_bpp, bool wide_bus,
+			     struct msm_dp_dsc_params *dsc)
+{
+	const u8 *dpcd = msm_dp_panel->dsc_dpcd;
+	struct drm_dsc_config *cfg = &dsc->cfg;
+	u32 bpc = src_bpp / 3, tgt_bpp = MSM_DP_DSC_TGT_BPP;
+	u32 comp_ratio, byte_count, sink_minor, line_buf;
+	u64 num;
+	int slices, ret;
+
+	memset(dsc, 0, sizeof(*dsc));
+
+	if (!msm_dp_panel->dsc_fec_capable || !wide_bus ||
+	    (src_bpp != 24 && src_bpp != 30))
+		return -EINVAL;
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return -EINVAL;
+
+	slices = msm_dp_dsc_pick_slices(dpcd, mode);
+	if (slices < 0)
+		return slices;
+
+	sink_minor = (dpcd[DP_DSC_REV - DP_DSC_SUPPORT] & DP_DSC_MINOR_MASK) >>
+		     DP_DSC_MINOR_SHIFT;
+
+	cfg->dsc_version_major = 1;
+	cfg->dsc_version_minor = sink_minor >= 2 ? 2 : 1;
+	cfg->pic_width = mode->hdisplay;
+	cfg->pic_height = mode->vdisplay;
+	cfg->slice_count = slices;
+	cfg->slice_width = mode->hdisplay / slices;
+	if (mode->vdisplay % 108 == 0)
+		cfg->slice_height = 108;
+	else if (mode->vdisplay % 16 == 0)
+		cfg->slice_height = 16;
+	else if (mode->vdisplay % 12 == 0)
+		cfg->slice_height = 12;
+	else
+		cfg->slice_height = 15;
+	cfg->bits_per_component = bpc;
+	cfg->bits_per_pixel = tgt_bpp << 4;
+	cfg->block_pred_enable = !!(dpcd[DP_DSC_BLK_PREDICTION_SUPPORT - DP_DSC_SUPPORT] &
+				    DP_DSC_BLK_PREDICTION_IS_SUPPORTED);
+	cfg->convert_rgb = 1;
+	cfg->simple_422 = 0;
+	cfg->native_422 = 0;
+	cfg->native_420 = 0;
+	cfg->vbr_enable = 0;
+
+	drm_dsc_set_const_params(cfg);
+	drm_dsc_set_rc_buf_thresh(cfg);
+	ret = drm_dsc_setup_rc_params(cfg, cfg->dsc_version_minor == 2 ?
+				      DRM_DSC_1_2_444 : DRM_DSC_1_1_PRE_SCR);
+	if (ret)
+		return ret;
+
+	cfg->initial_scale_value = drm_dsc_initial_scale_value(cfg);
+	cfg->line_buf_depth = bpc + 1;
+	line_buf = drm_dp_dsc_sink_line_buf_depth(dpcd);
+	if (line_buf && cfg->line_buf_depth > line_buf)
+		cfg->line_buf_depth = line_buf;
+
+	ret = drm_dsc_compute_rc_parameters(cfg);
+	if (ret)
+		return ret;
+
+	dsc->src_bpp = src_bpp;
+	dsc->tgt_bpp = tgt_bpp;
+	dsc->slice_count = slices;
+	dsc->bytes_in_slice = DIV_ROUND_UP(cfg->slice_width * tgt_bpp, 8);
+	dsc->bytes_per_line = dsc->bytes_in_slice * slices;
+
+	/* downstream dp_panel_dsc_pclk_param_calc() */
+	comp_ratio = mult_frac(100, src_bpp, tgt_bpp);
+	num = (u64)mode->hdisplay * bpc * 3 * 100;
+	byte_count = DIV_ROUND_UP_ULL(num, comp_ratio * slices * 8);
+	dsc->eol_byte_num = (3 - (byte_count * slices) % 3) % 3;
+	dsc->pclk_per_line = DIV_ROUND_UP_ULL(num, comp_ratio * 48);
+
+	msm_dp_dsc_dto_params(src_bpp, tgt_bpp, &dsc->dto_n, &dsc->dto_d);
+	if (!dsc->dto_n)
+		return -EINVAL;
+
+	dsc->extra_width = msm_dp_dsc_extra_width(mode->hdisplay / 2,
+						  dsc->pclk_per_line,
+						  dsc->dto_n, dsc->dto_d);
+	dsc->pclk_per_line--;
+	dsc->enabled = true;
+
+	return 0;
+}
+
+bool msm_dp_panel_dsc_mode_supported(struct msm_dp_panel *msm_dp_panel,
+				     const struct drm_display_mode *mode,
+				     u32 src_bpp, bool wide_bus)
+{
+	struct msm_dp_dsc_params *tmp;
+	bool ok;
+
+	tmp = kzalloc(sizeof(*tmp), GFP_KERNEL);
+	if (!tmp)
+		return false;
+	ok = !msm_dp_panel_dsc_compute(msm_dp_panel, mode, src_bpp, wide_bus, tmp);
+	kfree(tmp);
+
+	return ok;
+}
+
+/* downstream dp_header_get_parity(): all 8 nibbles once data > 0xff */
+static u8 msm_dp_dsc_pps_parity(u32 data)
+{
+	u8 x0 = 0, x1 = 0, ci, i;
+	u8 num_nibbles = data > 0xff ? 8 : 2;
+
+	for (i = 0; i < num_nibbles; i++) {
+		ci = ((data >> (i * 4)) & 0xf) ^ x1;
+		x1 = x0 ^ msm_dp_utils_get_g1_value(ci);
+		x0 = msm_dp_utils_get_g0_value(ci);
+	}
+
+	return x1 | (x0 << 4);
+}
+
+/**
+ * msm_dp_panel_dsc_config() - program DSC DTO, PPS SDP and compression mode
+ * @msm_dp_panel: DP panel
+ * @enable: program the panel's DSC state (true) or turn compression off
+ */
+void msm_dp_panel_dsc_config(struct msm_dp_panel *msm_dp_panel, bool enable)
+{
+	struct msm_dp_panel_private *panel =
+		container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	struct msm_dp_dsc_params *dsc = &msm_dp_panel->dsc;
+	struct drm_dsc_picture_parameter_set pps;
+	const u8 *b = (const u8 *)&pps;
+	u8 parity[24] = { 0 };
+	u32 reg, comp;
+	int i;
+
+	if (!enable || !dsc->enabled) {
+		msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+		msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, 0x0);
+		return;
+	}
+
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, dsc->pclk_per_line);
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, DP_DSC_DTO_EN |
+			FIELD_PREP(DP_DSC_DTO_N, dsc->dto_n) |
+			FIELD_PREP(DP_DSC_DTO_D, dsc->dto_d));
+
+	BUILD_BUG_ON(sizeof(pps) < DP_PPS_PAYLOAD_LEN);
+	drm_dsc_pps_payload_pack(&pps, &dsc->cfg);
+
+	msm_dp_write_link(panel, REG_DP_PPS_HB_0_3, 0x7F1000);
+	msm_dp_write_link(panel, REG_DP_PPS_PB_0_3, 0xA22300);
+
+	for (i = 0; i < DP_PPS_PAYLOAD_LEN / 4; i++) {
+		u32 w = b[4 * i] | b[4 * i + 1] << 8 |
+			b[4 * i + 2] << 16 | (u32)b[4 * i + 3] << 24;
+
+		parity[i] = msm_dp_dsc_pps_parity(w);
+		msm_dp_write_link(panel, REG_DP_PPS_PPS_0_3 + 4 * i, w);
+	}
+
+	for (i = 0; i < (DP_PPS_PAYLOAD_LEN / 4) / 4 + 1; i++)
+		msm_dp_write_link(panel, REG_DP_PPS_PB_4_7 + 4 * i,
+				  parity[4 * i] | parity[4 * i + 1] << 8 |
+				  parity[4 * i + 2] << 16 |
+				  (u32)parity[4 * i + 3] << 24);
+
+	comp = DP_COMPRESSION_MODE_EN |
+	       FIELD_PREP(DP_COMPRESSION_EOL_BYTE_NUM, dsc->eol_byte_num) |
+	       FIELD_PREP(DP_COMPRESSION_SLICE_PER_PKT, dsc->slice_count - 1) |
+	       FIELD_PREP(DP_COMPRESSION_BE_IN_LANE, 10) |
+	       FIELD_PREP(DP_COMPRESSION_BYTES_PER_PKT, dsc->bytes_in_slice);
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, comp);
+
+	/* send the PPS SDP with the next (peripheral) flush */
+	reg = msm_dp_read_link(panel, MMSS_DP_FLUSH);
+	reg |= DP_FLUSH_PPS;
+	msm_dp_write_link(panel, MMSS_DP_FLUSH, reg);
+
+	dev_info(panel->dev,
+		 "DP DSC on: %ux%u slices=%u slice=%ux%u bpc=%u->%ubpp v1.%u comp=0x%x dto=%u/%u cnt=%u extra=%u eol=%u\n",
+		 dsc->cfg.pic_width, dsc->cfg.pic_height, dsc->slice_count,
+		 dsc->cfg.slice_width, dsc->cfg.slice_height,
+		 dsc->cfg.bits_per_component, dsc->tgt_bpp,
+		 dsc->cfg.dsc_version_minor, comp, dsc->dto_n, dsc->dto_d,
+		 dsc->pclk_per_line, dsc->extra_width, dsc->eol_byte_num);
+}
