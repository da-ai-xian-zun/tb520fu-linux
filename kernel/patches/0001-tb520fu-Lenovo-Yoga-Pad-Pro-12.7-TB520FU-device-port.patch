+static int lenovo_kb_set_tp_autosleep(struct lenovo_kb_dev *kb, bool on)
+{
+	const u8 cmd[] = { 0x6a, 0x04, 0x33, 0x02, on ? 1 : 0, on ? 5 : 0 };
+
