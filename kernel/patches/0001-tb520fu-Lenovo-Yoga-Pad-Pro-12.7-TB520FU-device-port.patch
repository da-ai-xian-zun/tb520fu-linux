+		*n = 1; *d = 2;
+	} else if (tgt_bpp == 15 && src_bpp == 30) {
+		*n = 5; *d = 8;
+	} else if (tgt_bpp == 8 && (src_bpp == 24 || src_bpp == 30)) {
+		*n = 1; *d = 3;
+	} else if (tgt_bpp == 10 && src_bpp == 30) {
+		*n = 5; *d = 12;
