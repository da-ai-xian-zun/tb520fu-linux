+		for (i = 0; i < ret; i++)
+			len += scnprintf(buf+len, PAGE_SIZE-len, "%s:%d", ch_name[i], cali_f0[i]);
+		len += scnprintf(buf+len, PAGE_SIZE-len, "\n");
+	}
+
+	aw882xx_dev_put(local_dev);
+	return len;
+}
