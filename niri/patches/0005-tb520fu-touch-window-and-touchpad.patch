     /// Computes the cursor position for the touch event.
     ///
     /// This function handles the touch output mapping, as well as coordinate transform
+    fn hit_touch_window_target(
+        &self,
+        pos: Point<f64, Logical>,
+        tap_focus_window: Option<smithay::desktop::Window>,
+        is_pointer: bool,
+    ) -> Option<(self::touch_window_grab::WindowGrabTarget, bool)> {
