+                edges,
+                inside_win,
+            } => Some((
+                WindowGrabTarget::FloatingEdge {
+                    window: mapped.window.clone(),
+                    edges,
+                    inside_win,
+                },
+                true,
+            )),
+            WorkspaceTouchHit::ScrollingSeam(seam) => {
