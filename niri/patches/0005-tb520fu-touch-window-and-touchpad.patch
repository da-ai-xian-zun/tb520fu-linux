+                    let near_v_band = pos.y <= top + CORNER || pos.y >= bottom - CORNER;
+                    let near_h_band = pos.x <= left + CORNER || pos.x >= right - CORNER;
+                    let l_thresh = if near_v_band { CORNER } else { INNER };
+                    let r_thresh = if near_v_band { CORNER } else { INNER };
+                    let t_thresh = if near_h_band { CORNER } else { INNER };
+                    let b_thresh = if near_h_band { CORNER } else { INNER };
+
+                    if pos.x <= left + l_thresh {
+                        edges |= ResizeEdge::LEFT;
+                    } else if pos.x >= right - r_thresh {
+                        edges |= ResizeEdge::RIGHT;
+                    }
