diff --git a/src/input/touch_window_grab.rs b/src/input/touch_window_grab.rs
new file mode 100644
index 00000000..d226fcd0
--- /dev/null
+++ b/src/input/touch_window_grab.rs
@@ -0,0 +1,789 @@
+//! TB520FU: Compositor-native touch & pointer window manipulation:
+//! - Top-center `32x4` pill handle: tap opens `tb520fu-shell` Liquid Glass Window Menu,
+//!   drag runs 120Hz `interactive_move` without requiring keyboard `Mod`.
+//! - Floating windows (`prefer-no-csd`): extended border/corner hit zones run 120Hz `interactive_resize`.
+//! - Scrolling columns & stacks: coupled split-seam drag (`w_L + w_R = const` with `1/3 · 1/2 · 2/3`
+//!   detents & pinned viewport anchor), single-column outer-edge drag, stack row-seam drag, and
+//!   double-tap `50:50` reset.
+
+use std::io::Write;
+use std::os::unix::net::UnixStream;
+use std::time::Duration;
+
+use smithay::desktop::Window;
+use smithay::input::pointer::{
+    AxisFrame, ButtonEvent, CursorIcon, CursorImageStatus, GestureHoldBeginEvent,
+    GestureHoldEndEvent, GesturePinchBeginEvent, GesturePinchEndEvent, GesturePinchUpdateEvent,
+    GestureSwipeBeginEvent, GestureSwipeEndEvent, GestureSwipeUpdateEvent,
+    GrabStartData as PointerGrabStartData, MotionEvent as PointerMotionEvent, PointerGrab,
+    PointerInnerHandle, RelativeMotionEvent,
+};
+use smithay::input::touch::{
+    DownEvent, GrabStartData as TouchGrabStartData, MotionEvent as TouchMotionEvent,
+    OrientationEvent, ShapeEvent, TouchGrab, TouchInnerHandle, UpEvent,
+};
+use smithay::input::SeatHandler;
+use smithay::output::Output;
+use smithay::utils::{IsAlive, Logical, Point};
+
+use crate::layout::scrolling::ScrollingSeamHit;
+use crate::layout::workspace::WorkspaceId;
+use crate::niri::State;
+use crate::utils::{get_monotonic_time, ResizeEdge};
+
+const PILL_DRAG_THRESHOLD: f64 = 7.0;
+const EDGE_DRAG_THRESHOLD: f64 = 6.0;
+const SEAM_CORE_DRAG_THRESHOLD: f64 = 3.5;
+const SEAM_HALO_DRAG_THRESHOLD: f64 = 6.0;
+const SEAM_DOUBLE_TAP_WINDOW: Duration = Duration::from_millis(400);
+
+pub fn send_tb520fu_shell_cmd(cmd_line: &str) {
+    let path = if let Ok(rdir) = std::env::var("XDG_RUNTIME_DIR") {
+        let trimmed = rdir.trim().trim_end_matches('/');
+        if !trimmed.is_empty() {
+            format!("{trimmed}/tb520fu-shell.sock")
+        } else {
+            let uid = unsafe { libc::getuid() };
+            format!("/run/user/{uid}/tb520fu-shell.sock")
+        }
+    } else {
+        let uid = unsafe { libc::getuid() };
+        format!("/run/user/{uid}/tb520fu-shell.sock")
+    };
+    if let Ok(mut stream) = UnixStream::connect(path) {
+        let _ = stream.set_nonblocking(true);
+        let mut msg = cmd_line.trim().to_string();
+        msg.push('\n');
+        let _ = stream.write_all(msg.as_bytes());
+    }
+}
+
+#[derive(Clone)]
+pub enum WindowGrabTarget {
+    TopPill {
+        window: Window,
+        win_id_u64: u64,
+        pill_anchor_on_output: Point<f64, Logical>,
+        is_floating: bool,
+        output: Output,
+        start_pos_within_output: Point<f64, Logical>,
+    },
+    FloatingEdge {
+        window: Window,
+        edges: ResizeEdge,
+        inside_win: bool,
+    },
+    ScrollingSeam {
+        ws_id: WorkspaceId,
+        seam: ScrollingSeamHit<Window>,
+        tap_focus_window: Option<Window>,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ActivePhase {
+    Recognizing,
+    Moving,
+    ResizingFloating,
+    ResizingSeam,
+    Aborted,
+}
+
+pub struct TouchWindowGrab {
+    start_data: TouchGrabStartData<State>,
+    last_location: Point<f64, Logical>,
+    target: WindowGrabTarget,
+    swallow_down: bool,
+    phase: ActivePhase,
+}
+
+impl TouchWindowGrab {
+    pub fn new(
+        start_data: TouchGrabStartData<State>,
+        target: WindowGrabTarget,
+        swallow_down: bool,
+    ) -> Self {
+        let last_location = start_data.location;
+        Self {
+            start_data,
+            last_location,
+            target,
+            swallow_down,
+            phase: ActivePhase::Recognizing,
+        }
+    }
+
+    fn cleanup(&mut self, state: &mut State) {
+        match (&self.target, self.phase) {
+            (WindowGrabTarget::TopPill { window, .. }, ActivePhase::Moving) => {
+                state.niri.layout.interactive_move_end(window);
+                state.niri.queue_redraw_all();
+            }
+            (WindowGrabTarget::FloatingEdge { window, .. }, ActivePhase::ResizingFloating) => {
+                state.niri.layout.interactive_resize_end(window);
+                state.niri.queue_redraw_all();
+            }
+            (WindowGrabTarget::ScrollingSeam { ws_id, .. }, ActivePhase::ResizingSeam) => {
+                state.niri.layout.end_touch_seam_drag(*ws_id);
+                state.niri.queue_redraw_all();
+            }
+            _ => {}
+        }
+        self.phase = ActivePhase::Aborted;
+    }
+}
+
+impl TouchGrab<State> for TouchWindowGrab {
+    fn down(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        event: &DownEvent,
+    ) {
+        if !self.swallow_down && event.slot == self.start_data.slot {
+            handle.down(data, focus, event);
+        } else {
+            handle.down(data, None, event);
+        }
+    }
+
+    fn up(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &UpEvent,
+    ) {
+        handle.up(data, event);
+        if event.slot != self.start_data.slot {
+            return;
+        }
+
+        if self.phase == ActivePhase::Recognizing && !data.niri.touch_pinch.cancelling {
+            match &self.target {
+                WindowGrabTarget::TopPill {
+                    window,
+                    win_id_u64,
+                    pill_anchor_on_output,
+                    is_floating,
+                    ..
+                } => {
+                    if window.alive() {
+                        data.niri.layout.activate_window(window);
+                        data.niri.queue_redraw_all();
+                        send_tb520fu_shell_cmd(&format!(
+                            "win-menu {} {:.1} {:.1} {}",
+                            win_id_u64,
+                            pill_anchor_on_output.x,
+                            pill_anchor_on_output.y,
+                            if *is_floating { 1 } else { 0 }
+                        ));
+                    }
+                }
+                WindowGrabTarget::FloatingEdge {
+                    window, inside_win, ..
+                } => {
+                    if *inside_win && window.alive() {
+                        data.niri.layout.activate_window(window);
+                        data.niri.queue_redraw_all();
+                    }
+                }
+                WindowGrabTarget::ScrollingSeam {
+                    ws_id,
+                    seam,
+                    tap_focus_window,
+                } => {
+                    let now = get_monotonic_time();
+                    let pos = self.start_data.location;
+                    let is_double = data.niri.last_seam_tap.is_some_and(|(prev_t, prev_p)| {
+                        now.saturating_sub(prev_t) <= SEAM_DOUBLE_TAP_WINDOW
+                            && (pos.x - prev_p.x).hypot(pos.y - prev_p.y) <= 38.0
+                    });
+                    if is_double {
+                        data.niri.last_seam_tap = None;
+                        data.niri.touch_gate.mark_not_tap(1);
+                        if data.niri.layout.apply_touch_seam_double_tap(*ws_id, seam) {
+                            data.niri.queue_redraw_all();
+                        }
+                    } else {
+                        data.niri.last_seam_tap = Some((now, pos));
+                        if !self.swallow_down {
+                            if let Some(w) = tap_focus_window {
+                                if w.alive() {
+                                    data.niri.layout.activate_window(w);
+                                    data.niri.queue_redraw_all();
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        handle.unset_grab(self, data);
+    }
+
+    fn motion(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        event: &TouchMotionEvent,
+    ) {
+        if event.slot != self.start_data.slot {
+            handle.motion(data, None, event);
+            return;
+        }
+
+        let total_delta = event.location - self.start_data.location;
+        let step_delta = event.location - self.last_location;
+        self.last_location = event.location;
+
+        if self.phase == ActivePhase::Recognizing {
+            match &self.target {
+                WindowGrabTarget::TopPill {
+                    window,
+                    output,
+                    start_pos_within_output,
+                    ..
+                } => {
+                    handle.motion(data, None, event);
+                    if !window.alive() {
+                        handle.unset_grab(self, data);
+                        return;
+                    }
+                    if total_delta.x.hypot(total_delta.y) >= PILL_DRAG_THRESHOLD {
+                        data.niri.touch_gate.mark_not_tap(1);
+                        data.niri.layout.activate_window(window);
+                        if data.niri.layout.interactive_move_begin(
+                            window.clone(),
+                            output,
+                            *start_pos_within_output,
+                        ) {
+                            self.phase = ActivePhase::Moving;
+                            if let Some((out, pos_in_out)) = data.niri.output_under(event.location)
+                            {
+                                let out = out.clone();
+                                data.niri.layout.interactive_move_update(
+                                    window,
+                                    total_delta,
+                                    out,
+                                    pos_in_out,
+                                );
+                                data.niri.queue_redraw_all();
+                            }
+                        } else {
+                            handle.unset_grab(self, data);
+                        }
+                    }
+                    return;
+                }
+                WindowGrabTarget::FloatingEdge { window, edges, .. } => {
+                    handle.motion(data, None, event);
+                    if !window.alive() {
+                        handle.unset_grab(self, data);
+                        return;
+                    }
+                    if total_delta.x.hypot(total_delta.y) >= EDGE_DRAG_THRESHOLD {
+                        data.niri.touch_gate.mark_not_tap(1);
+                        data.niri.layout.activate_window(window);
+                        if data
+                            .niri
+                            .layout
+                            .interactive_resize_begin(window.clone(), *edges)
+                        {
+                            self.phase = ActivePhase::ResizingFloating;
+                            data.niri
+                                .layout
+                                .interactive_resize_update(window, total_delta);
+                            data.niri.queue_redraw_all();
+                        } else {
+                            handle.unset_grab(self, data);
+                        }
+                    }
+                    return;
+                }
+                WindowGrabTarget::ScrollingSeam { ws_id, seam, .. } => {
+                    let is_row = matches!(seam, ScrollingSeamHit::RowSeam { .. });
+                    let (along, perp) = if is_row {
+                        (total_delta.y.abs(), total_delta.x.abs())
+                    } else {
+                        (total_delta.x.abs(), total_delta.y.abs())
+                    };
+                    if !self.swallow_down && perp >= 24.0 && perp > along * 2.4 {
+                        // Strong perpendicular scroll inside window halo: yield to client!
+                        handle.motion(data, focus, event);
+                        self.phase = ActivePhase::Aborted;
+                        handle.unset_grab(self, data);
+                        return;
+                    }
+                    let thresh = if self.swallow_down {
+                        SEAM_CORE_DRAG_THRESHOLD
+                    } else {
+                        SEAM_HALO_DRAG_THRESHOLD
+                    };
+                    if along >= thresh && (self.swallow_down || along * 1.4 >= perp) {
+                        data.niri.touch_gate.mark_not_tap(1);
+                        if !self.swallow_down {
+                            handle.cancel(data);
+                        } else {
+                            handle.motion(data, None, event);
+                        }
+                        self.phase = ActivePhase::ResizingSeam;
+                        if data
+                            .niri
+                            .layout
+                            .apply_touch_seam_drag(*ws_id, seam, total_delta)
+                        {
+                            data.niri.queue_redraw_all();
+                        }
+                        return;
+                    }
+                    if self.swallow_down {
+                        handle.motion(data, None, event);
+                    } else {
+                        handle.motion(data, focus, event);
+                    }
+                    return;
+                }
+            }
+        }
+
+        handle.motion(data, None, event);
+
+        match (&self.target, self.phase) {
+            (WindowGrabTarget::TopPill { window, .. }, ActivePhase::Moving) => {
+                if !window.alive() {
+                    handle.unset_grab(self, data);
+                    return;
+                }
+                if let Some((out, pos_in_out)) = data.niri.output_under(event.location) {
+                    let out = out.clone();
+                    if data
+                        .niri
+                        .layout
+                        .interactive_move_update(window, step_delta, out, pos_in_out)
+                    {
+                        data.niri.queue_redraw_all();
+                    } else {
+                        handle.unset_grab(self, data);
+                    }
+                }
+            }
+            (WindowGrabTarget::FloatingEdge { window, .. }, ActivePhase::ResizingFloating) => {
+                if !window.alive()
+                    || !data
+                        .niri
+                        .layout
+                        .interactive_resize_update(window, total_delta)
+                {
+                    handle.unset_grab(self, data);
+                    return;
+                }
+                data.niri.queue_redraw_all();
+            }
+            (WindowGrabTarget::ScrollingSeam { ws_id, seam, .. }, ActivePhase::ResizingSeam) => {
+                if data
+                    .niri
+                    .layout
+                    .apply_touch_seam_drag(*ws_id, seam, total_delta)
+                {
+                    data.niri.queue_redraw_all();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn frame(&mut self, data: &mut State, handle: &mut TouchInnerHandle<'_, State>) {
+        handle.frame(data);
+    }
+
+    fn cancel(&mut self, data: &mut State, handle: &mut TouchInnerHandle<'_, State>) {
+        handle.cancel(data);
+        handle.unset_grab(self, data);
+    }
+
+    fn shape(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &ShapeEvent,
+    ) {
+        handle.shape(data, event);
+    }
+
+    fn orientation(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &OrientationEvent,
+    ) {
+        handle.orientation(data, event);
+    }
+
+    fn start_data(&self) -> &TouchGrabStartData<State> {
+        &self.start_data
+    }
+
+    fn unset(&mut self, data: &mut State) {
+        self.cleanup(data);
+    }
+}
+
+pub struct PointerWindowGrab {
+    start_data: PointerGrabStartData<State>,
+    last_location: Point<f64, Logical>,
+    target: WindowGrabTarget,
+    phase: ActivePhase,
+}
+
+impl PointerWindowGrab {
+    pub fn new(start_data: PointerGrabStartData<State>, target: WindowGrabTarget) -> Self {
+        let last_location = start_data.location;
+        Self {
+            start_data,
+            last_location,
+            target,
+            phase: ActivePhase::Recognizing,
+        }
+    }
+
+    fn cleanup(&mut self, state: &mut State) {
+        match (&self.target, self.phase) {
+            (WindowGrabTarget::TopPill { window, .. }, ActivePhase::Moving) => {
+                state.niri.layout.interactive_move_end(window);
+                state
+                    .niri
+                    .cursor_manager
+                    .set_cursor_image(CursorImageStatus::default_named());
+                state.niri.queue_redraw_all();
+            }
+            (WindowGrabTarget::FloatingEdge { window, .. }, ActivePhase::ResizingFloating) => {
+                state.niri.layout.interactive_resize_end(window);
+                state
+                    .niri
+                    .cursor_manager
+                    .set_cursor_image(CursorImageStatus::default_named());
+                state.niri.queue_redraw_all();
+            }
+            (WindowGrabTarget::ScrollingSeam { ws_id, .. }, ActivePhase::ResizingSeam) => {
+                state.niri.layout.end_touch_seam_drag(*ws_id);
+                state
+                    .niri
+                    .cursor_manager
+                    .set_cursor_image(CursorImageStatus::default_named());
+                state.niri.queue_redraw_all();
+            }
+            _ => {}
+        }
+        self.phase = ActivePhase::Aborted;
+    }
+}
+
+impl PointerGrab<State> for PointerWindowGrab {
+    fn motion(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::PointerFocus, Point<f64, Logical>)>,
+        event: &PointerMotionEvent,
+    ) {
+        handle.motion(data, None, event);
+
+        let total_delta = event.location - self.start_data.location;
+        let step_delta = event.location - self.last_location;
+        self.last_location = event.location;
+
+        if self.phase == ActivePhase::Recognizing {
+            match &self.target {
+                WindowGrabTarget::TopPill {
+                    window,
+                    output,
+                    start_pos_within_output,
+                    ..
+                } => {
+                    if total_delta.x.hypot(total_delta.y) >= 5.0 && window.alive() {
+                        data.niri.layout.activate_window(window);
+                        if data.niri.layout.interactive_move_begin(
+                            window.clone(),
+                            output,
+                            *start_pos_within_output,
+                        ) {
+                            self.phase = ActivePhase::Moving;
+                            data.niri
+                                .cursor_manager
+                                .set_cursor_image(CursorImageStatus::Named(CursorIcon::Grabbing));
+                            if let Some((out, pos_in_out)) = data.niri.output_under(event.location)
+                            {
+                                let out = out.clone();
+                                data.niri.layout.interactive_move_update(
+                                    window,
+                                    total_delta,
+                                    out,
+                                    pos_in_out,
+                                );
+                                data.niri.queue_redraw_all();
+                            }
+                        }
+                    }
+                    return;
+                }
+                WindowGrabTarget::FloatingEdge { window, edges, .. } => {
+                    if total_delta.x.hypot(total_delta.y) >= 4.0 && window.alive() {
+                        data.niri.layout.activate_window(window);
+                        if data
+                            .niri
+                            .layout
+                            .interactive_resize_begin(window.clone(), *edges)
+                        {
+                            self.phase = ActivePhase::ResizingFloating;
+                            data.niri
+                                .cursor_manager
+                                .set_cursor_image(CursorImageStatus::Named(edges.cursor_icon()));
+                            data.niri
+                                .layout
+                                .interactive_resize_update(window, total_delta);
+                            data.niri.queue_redraw_all();
+                        }
+                    }
+                    return;
+                }
+                WindowGrabTarget::ScrollingSeam { ws_id, seam, .. } => {
+                    let is_row = matches!(seam, ScrollingSeamHit::RowSeam { .. });
+                    let along = if is_row {
+                        total_delta.y.abs()
+                    } else {
+                        total_delta.x.abs()
+                    };
+                    if along >= 3.5 {
+                        self.phase = ActivePhase::ResizingSeam;
+                        let icon = if is_row {
+                            CursorIcon::RowResize
+                        } else {
+                            CursorIcon::ColResize
+                        };
+                        data.niri
+                            .cursor_manager
+                            .set_cursor_image(CursorImageStatus::Named(icon));
+                        if data
+                            .niri
+                            .layout
+                            .apply_touch_seam_drag(*ws_id, seam, total_delta)
+                        {
+                            data.niri.queue_redraw_all();
+                        }
+                    }
+                    return;
+                }
+            }
+        }
+
+        match (&self.target, self.phase) {
+            (WindowGrabTarget::TopPill { window, .. }, ActivePhase::Moving) => {
+                if let Some((out, pos_in_out)) = data.niri.output_under(event.location) {
+                    let out = out.clone();
+                    if data
+                        .niri
+                        .layout
+                        .interactive_move_update(window, step_delta, out, pos_in_out)
+                    {
+                        data.niri.queue_redraw_all();
+                        return;
+                    }
+                }
+                handle.unset_grab(self, data, event.serial, event.time, true);
+            }
+            (WindowGrabTarget::FloatingEdge { window, .. }, ActivePhase::ResizingFloating) => {
+                if window.alive()
+                    && data
+                        .niri
+                        .layout
+                        .interactive_resize_update(window, total_delta)
+                {
+                    data.niri.queue_redraw_all();
+                    return;
+                }
+                handle.unset_grab(self, data, event.serial, event.time, true);
+            }
+            (WindowGrabTarget::ScrollingSeam { ws_id, seam, .. }, ActivePhase::ResizingSeam) => {
+                if data
+                    .niri
+                    .layout
+                    .apply_touch_seam_drag(*ws_id, seam, total_delta)
+                {
+                    data.niri.queue_redraw_all();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn relative_motion(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::PointerFocus, Point<f64, Logical>)>,
+        event: &RelativeMotionEvent,
+    ) {
+        handle.relative_motion(data, None, event);
+    }
+
+    fn button(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &ButtonEvent,
+    ) {
+        handle.button(data, event);
+        if !handle.current_pressed().is_empty() {
+            return;
+        }
+
+        if self.phase == ActivePhase::Recognizing {
+            match &self.target {
+                WindowGrabTarget::TopPill {
+                    window,
+                    win_id_u64,
+                    pill_anchor_on_output,
+                    is_floating,
+                    ..
+                } => {
+                    if window.alive() {
+                        data.niri.layout.activate_window(window);
+                        data.niri.queue_redraw_all();
+                        send_tb520fu_shell_cmd(&format!(
+                            "win-menu {} {:.1} {:.1} {}",
+                            win_id_u64,
+                            pill_anchor_on_output.x,
+                            pill_anchor_on_output.y,
+                            if *is_floating { 1 } else { 0 }
+                        ));
+                    }
+                }
+                WindowGrabTarget::ScrollingSeam {
+                    ws_id,
+                    seam,
+                    tap_focus_window,
+                } => {
+                    let now = get_monotonic_time();
+                    let pos = self.start_data.location;
+                    let is_double = data.niri.last_seam_tap.is_some_and(|(prev_t, prev_p)| {
+                        now.saturating_sub(prev_t) <= SEAM_DOUBLE_TAP_WINDOW
+                            && (pos.x - prev_p.x).hypot(pos.y - prev_p.y) <= 28.0
+                    });
+                    if is_double {
+                        data.niri.last_seam_tap = None;
+                        if data.niri.layout.apply_touch_seam_double_tap(*ws_id, seam) {
+                            data.niri.queue_redraw_all();
+                        }
+                    } else {
+                        data.niri.last_seam_tap = Some((now, pos));
+                        if let Some(w) = tap_focus_window {
+                            if w.alive() {
+                                data.niri.layout.activate_window(w);
+                                data.niri.queue_redraw_all();
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        handle.unset_grab(self, data, event.serial, event.time, true);
+    }
+
+    fn axis(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        details: AxisFrame,
+    ) {
+        handle.axis(data, details);
+    }
+
+    fn frame(&mut self, data: &mut State, handle: &mut PointerInnerHandle<'_, State>) {
+        handle.frame(data);
+    }
+
+    fn gesture_swipe_begin(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GestureSwipeBeginEvent,
+    ) {
+        handle.gesture_swipe_begin(data, event);
+    }
+
+    fn gesture_swipe_update(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GestureSwipeUpdateEvent,
+    ) {
+        handle.gesture_swipe_update(data, event);
+    }
+
+    fn gesture_swipe_end(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GestureSwipeEndEvent,
+    ) {
+        handle.gesture_swipe_end(data, event);
+    }
+
+    fn gesture_pinch_begin(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GesturePinchBeginEvent,
+    ) {
+        handle.gesture_pinch_begin(data, event);
+    }
+
+    fn gesture_pinch_update(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GesturePinchUpdateEvent,
+    ) {
+        handle.gesture_pinch_update(data, event);
+    }
+
+    fn gesture_pinch_end(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GesturePinchEndEvent,
+    ) {
+        handle.gesture_pinch_end(data, event);
+    }
+
+    fn gesture_hold_begin(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GestureHoldBeginEvent,
+    ) {
+        handle.gesture_hold_begin(data, event);
+    }
+
+    fn gesture_hold_end(
+        &mut self,
+        data: &mut State,
+        handle: &mut PointerInnerHandle<'_, State>,
+        event: &GestureHoldEndEvent,
+    ) {
+        handle.gesture_hold_end(data, event);
+    }
+
+    fn start_data(&self) -> &PointerGrabStartData<State> {
+        &self.start_data
+    }
+
+    fn unset(&mut self, data: &mut State) {
+        self.cleanup(data);
+    }
+}
