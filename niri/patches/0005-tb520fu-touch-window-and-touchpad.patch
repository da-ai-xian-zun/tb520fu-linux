+                const OUTER: f64 = 18.;
+                const INNER: f64 = 10.;
+                const CORNER: f64 = 26.;
+                let in_outer = pos.x >= left - OUTER
+                    && pos.x <= right + OUTER
+                    && pos.y >= top - OUTER
+                    && pos.y <= bottom + OUTER;
+                let in_strict_inner = pos.x > left + INNER
+                    && pos.x < right - INNER
+                    && pos.y > top + INNER
+                    && pos.y < bottom - INNER;
