@@ -0,0 +1,391 @@
+//! Panel EDR: HDR headroom on an SDR-only built-in panel through its backlight + HBM.
+//!
+//! A DSI panel has no HDR signalling, but it does have a backlight that is usually far from
+//! full plus KTZ8866 High Brightness Mode (`0x15` 20.4 / 25.2 / 28.4 mA, up to ~905 cd/m²).
+//! While HDR content is on screen, niri raises the backlight towards full (and asks
+//! `tb520fu-daemon` for HBM headroom when `panel-peak-luminance` > 650 cd/m²) and dims SDR
+//! content by the exact confirmed luminance ratio, so the desktop keeps its brightness and HDR
+//! highlights get the headroom (the approach KWin and Android use on laptop/tablet panels).
+//!
+//! The backlight and HBM duty-cycle / thermal safety policy are owned by `tb520fu-daemon`:
+//! `{"cmd":"edr","raw":N,"hbm":H}` raises the backlight to `N` with requested HBM step `H`
+//! (`0..=2`), and `{"cmd":"edr","raw":null,"hbm":0}` restores user brightness and HBM=0.
+//! The daemon replies with its status, including `backlight_raw` and `hbm_gain` (`1.0`,
+//! `1.2353`, or `1.3922`) actually applied after rolling 300s/1800s budget and thermal checks.
+//!
+//! Safety: SDR content is only dimmed by the luminance ratio the daemon *confirmed*, so if the
+//! daemon is missing, refuses, or steps HBM down on thermal/duty-cycle limits, frames follow
+//! the confirmed level smoothly instead of over-dimming or jumping.
+
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixStream;
+use std::sync::mpsc::{self, RecvTimeoutError};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use crate::render_helpers::blend::{PanelBlend, DEFAULT_REFERENCE_LUMINANCE};
+
+const DAEMON_SOCK: &str = "/run/tb520fu-daemon.sock";
+const BACKLIGHT_DIR: &str = "/sys/class/backlight/ktz8866-backlight";
+
+/// Full-backlight (raw = 2047) luminance at HBM=0 (20.4 mA), per Android display calibration.
+const BASE_PEAK_NITS: f32 = 650.0;
+/// Time to ramp the panel luminance between the user's SDR white and configured peak.
+const RAMP: Duration = Duration::from_millis(400);
+/// Interval at which the IPC thread repeats the current level and syncs daemon HBM gain.
+const KEEPALIVE: Duration = Duration::from_millis(250);
+/// How often the user's brightness is re-read from sysfs while EDR is idle.
+const SYSFS_POLL: Duration = Duration::from_millis(500);
+/// After ending EDR, sysfs may still show the raised level until the daemon restores it.
+const RESTORE_GRACE: Duration = Duration::from_millis(1000);
+
+#[derive(Debug, Clone, Copy)]
+struct Shared {
+    /// The user's (SDR) brightness as reported by the daemon while EDR is engaged.
+    user_raw: Option<i64>,
+    /// The backlight value the daemon applied for our EDR request, if EDR is engaged.
+    applied_raw: Option<i64>,
+    /// Multiplicative luminance gain confirmed by `tb520fu-daemon` for active HBM (`>= 1.0`).
+    hbm_gain: f32,
+    /// True when the daemon capped HBM due to rolling 300s/1800s budget or battery temperature.
+    hbm_throttled: bool,
+}
+
+impl Default for Shared {
+    fn default() -> Self {
+        Self {
+            user_raw: None,
+            applied_raw: None,
+            hbm_gain: 1.0,
+            hbm_throttled: false,
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Cmd {
+    Set { raw: i64, hbm: u8 },
+    End,
+}
+
+pub struct PanelEdr {
+    tx: mpsc::Sender<Cmd>,
+    shared: Arc<Mutex<Shared>>,
+    max_raw: i64,
+    user_raw: i64,
+    /// 0 = user's brightness, 1 = configured `panel-peak-luminance`.
+    level: f32,
+    target: f32,
+    last_tick: Option<Instant>,
+    engaged: bool,
+    last_sent: Option<(i64, u8)>,
+    next_poll: Option<Instant>,
+}
+
+impl PanelEdr {
+    pub fn new() -> Self {
+        let max_raw = read_sysfs_i64("max_brightness").filter(|&m| m > 0).unwrap_or(2047);
+        let user_raw = read_sysfs_i64("brightness").unwrap_or(max_raw / 2).clamp(1, max_raw);
+        let shared = Arc::new(Mutex::new(Shared::default()));
+        let (tx, rx) = mpsc::channel();
+
+        let shared_worker = shared.clone();
+        let res = std::thread::Builder::new()
+            .name("panel-edr-ipc".into())
+            .spawn(move || ipc_thread(rx, shared_worker));
+        if let Err(err) = res {
+            warn!("error spawning panel EDR IPC thread: {err:?}");
+        }
+
+        Self {
+            tx,
+            shared,
+            max_raw,
+            user_raw,
+            level: 0.,
+            target: 0.,
+            last_tick: None,
+            engaged: false,
+            last_sent: None,
+            next_poll: None,
+        }
+    }
+
+    #[inline]
+    fn base_full(peak_full: f32) -> f32 {
+        peak_full.min(BASE_PEAK_NITS)
+    }
+
+    /// The user's SDR white luminance at HBM=0, in cd/m².
+    pub fn sdr_luminance(&self, peak_full: f32) -> f32 {
+        let base = Self::base_full(peak_full);
+        (base * (self.user_raw as f32 / self.max_raw as f32)).max(1.)
+    }
+
+    /// How far above the user's SDR white the panel can go, as a ratio (>= 1).
+    pub fn headroom(&self, peak_full: f32) -> f32 {
+        let base = Self::base_full(peak_full);
+        let sdr = self.sdr_luminance(peak_full);
+        let sh = *self.shared.lock().unwrap();
+        let effective_peak = if self.engaged && sh.hbm_throttled {
+            base * sh.hbm_gain.max(1.0)
+        } else {
+            peak_full.max(base)
+        };
+        (effective_peak / sdr).max(1.)
+    }
+
+    /// Whether the backlight is still moving, so the output needs more frames.
+    pub fn is_animating(&self) -> bool {
+        if self.level != self.target {
+            return true;
+        }
+        // Keep drawing until the daemon has confirmed the raw level we asked for, so the SDR
+        // dimming catches up with the backlight.
+        let applied = self.shared.lock().unwrap().applied_raw;
+        self.engaged && applied != self.last_sent.map(|(r, _)| r)
+    }
+
+    /// Advances the backlight/HBM ramp towards `want` (HDR content on screen) and returns the
+    /// panel blend for the frame being rendered, or `None` for a plain SDR frame.
+    pub fn tick(&mut self, want: bool, peak_full: f32) -> Option<PanelBlend> {
+        let now = Instant::now();
+        let dt = self
+            .last_tick
+            .map(|t| now.saturating_duration_since(t))
+            .unwrap_or_default()
+            .min(Duration::from_millis(100));
+        self.last_tick = Some(now);
+
+        self.target = if want { 1. } else { 0. };
+        let step = dt.as_secs_f32() / RAMP.as_secs_f32();
+        if self.level < self.target {
+            self.level = (self.level + step).min(self.target);
+        } else if self.level > self.target {
+            self.level = (self.level - step).max(self.target);
+        }
+        // The first tick after a pause has dt = 0; make sure the ramp still starts.
+        if want && self.level == 0. {
+            self.level = f32::EPSILON;
+        }
+
+        let shared = *self.shared.lock().unwrap();
+        if self.engaged {
+            if let Some(user) = shared.user_raw {
+                self.user_raw = user.clamp(1, self.max_raw);
+            }
+        } else if self.next_poll.is_none_or(|t| now >= t) {
+            self.next_poll = Some(now + SYSFS_POLL);
+            if let Some(raw) = read_sysfs_i64("brightness") {
+                self.user_raw = raw.clamp(1, self.max_raw);
+            }
+        }
+
+        let base = Self::base_full(peak_full);
+        let sdr_lum = self.sdr_luminance(peak_full);
+
+        if self.level > 0. {
+            let t = self.level * self.level * (3. - 2. * self.level);
+            let goal_peak = peak_full.max(sdr_lum);
+            let desired_nits = sdr_lum + (goal_peak - sdr_lum) * t;
+            let raw = if desired_nits >= base {
+                self.max_raw
+            } else {
+                ((desired_nits / base.max(1.)) * self.max_raw as f32).round() as i64
+            }
+            .clamp(self.user_raw, self.max_raw);
+
+            let want_hbm = if raw < self.max_raw || peak_full <= BASE_PEAK_NITS + 10. {
+                0
+            } else if peak_full >= 850. && desired_nits >= 820. {
+                2
+            } else if peak_full >= 740. && desired_nits >= 725. {
+                1
+            } else {
+                0
+            };
+
+            if self.last_sent != Some((raw, want_hbm)) {
+                let _ = self.tx.send(Cmd::Set { raw, hbm: want_hbm });
+                self.last_sent = Some((raw, want_hbm));
+            }
+            self.engaged = true;
+        } else if self.engaged {
+            let _ = self.tx.send(Cmd::End);
+            self.engaged = false;
+            self.last_sent = None;
+            self.next_poll = Some(now + RESTORE_GRACE);
+        }
+
+        let applied = if self.engaged {
+            shared.applied_raw
+        } else {
+            None
+        }?;
+        let gain = if self.engaged {
+            shared.hbm_gain.max(1.0)
+        } else {
+            1.0
+        };
+        let confirmed_peak = base * (applied as f32 / self.max_raw as f32) * gain;
+        if confirmed_peak <= sdr_lum + 0.5 {
+            return None;
+        }
+        Some(PanelBlend {
+            sdr_luminance: sdr_lum,
+            peak_luminance: confirmed_peak,
+            reference_luminance: DEFAULT_REFERENCE_LUMINANCE as f32,
+        })
+    }
+
+    /// Restores the user's brightness immediately (session paused, output gone, HDR disabled).
+    pub fn stop(&mut self) {
+        if self.engaged {
+            let _ = self.tx.send(Cmd::End);
+        }
+        self.engaged = false;
+        self.level = 0.;
+        self.target = 0.;
+        self.last_sent = None;
+        self.last_tick = None;
+        self.next_poll = Some(Instant::now() + RESTORE_GRACE);
+    }
+}
+
+impl Drop for PanelEdr {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+fn read_sysfs_i64(name: &str) -> Option<i64> {
+    std::fs::read_to_string(format!("{BACKLIGHT_DIR}/{name}"))
+        .ok()?
+        .trim()
+        .parse()
+        .ok()
+}
+
+struct Conn {
+    stream: UnixStream,
+    reader: BufReader<UnixStream>,
+}
+
+impl Conn {
+    fn connect() -> std::io::Result<Self> {
+        let stream = UnixStream::connect(DAEMON_SOCK)?;
+        stream.set_read_timeout(Some(Duration::from_millis(500)))?;
+        stream.set_write_timeout(Some(Duration::from_millis(500)))?;
+        let reader = BufReader::new(stream.try_clone()?);
+        Ok(Self { stream, reader })
+    }
+
+    fn request(&mut self, req: Option<(i64, u8)>) -> std::io::Result<serde_json::Value> {
+        let msg = match req {
+            Some((raw, hbm)) => serde_json::json!({ "cmd": "edr", "raw": raw, "hbm": hbm }),
+            None => serde_json::json!({ "cmd": "edr", "raw": null, "hbm": 0 }),
+        };
+        let mut line = msg.to_string();
+        line.push('\n');
+        self.stream.write_all(line.as_bytes())?;
+        let mut reply = String::new();
+        if self.reader.read_line(&mut reply)? == 0 {
+            return Err(std::io::ErrorKind::UnexpectedEof.into());
+        }
+        serde_json::from_str(&reply).map_err(std::io::Error::other)
+    }
+}
+
+fn ipc_thread(rx: mpsc::Receiver<Cmd>, shared: Arc<Mutex<Shared>>) {
+    let mut conn: Option<Conn> = None;
+    // The (raw, hbm) level to keep re-sending while engaged.
+    let mut current: Option<(i64, u8)> = None;
+    let mut warned = false;
+
+    loop {
+        let cmd = match rx.recv_timeout(KEEPALIVE) {
+            Ok(cmd) => Some(cmd),
+            Err(RecvTimeoutError::Timeout) => None,
+            Err(RecvTimeoutError::Disconnected) => break,
+        };
+        // Coalesce queued commands: only the newest matters.
+        let mut cmd = cmd;
+        while let Ok(next) = rx.try_recv() {
+            cmd = Some(next);
+        }
+
+        let req = match cmd {
+            Some(Cmd::Set { raw, hbm }) => {
+                current = Some((raw, hbm));
+                Some((raw, hbm))
+            }
+            Some(Cmd::End) => {
+                current = None;
+                None
+            }
+            None => match current {
+                // Keepalive.
+                Some(pair) => Some(pair),
+                None => continue,
+            },
+        };
+
+        let mut reply = None;
+        for _ in 0..2 {
+            if conn.is_none() {
+                conn = Conn::connect().ok();
+            }
+            let Some(c) = conn.as_mut() else { break };
+            match c.request(req) {
+                Ok(v) => {
+                    reply = Some(v);
+                    break;
+                }
+                Err(_) => conn = None,
+            }
+        }
+
+        let mut sh = shared.lock().unwrap();
+        match reply {
+            Some(v) => {
+                warned = false;
+                let edr = v.get("edr").and_then(|x| x.as_bool()).unwrap_or(false);
+                sh.user_raw = v.get("brightness_raw").and_then(|x| x.as_i64());
+                sh.applied_raw = if edr && req.is_some() {
+                    v.get("backlight_raw").and_then(|x| x.as_i64())
+                } else {
+                    None
+                };
+                sh.hbm_gain = if edr && req.is_some() {
+                    v.get("hbm_gain")
+                        .and_then(|x| x.as_f64())
+                        .map(|g| g as f32)
+                        .filter(|&g| g >= 1.0)
+                        .unwrap_or(1.0)
+                } else {
+                    1.0
+                };
+                sh.hbm_throttled = v
+                    .get("hbm_throttled")
+                    .and_then(|x| x.as_bool())
+                    .unwrap_or(false);
+            }
+            None => {
+                if !warned {
+                    warn!("panel EDR: tb520fu-daemon unreachable at {DAEMON_SOCK}");
+                    warned = true;
+                }
+                sh.applied_raw = None;
+                sh.hbm_gain = 1.0;
+                sh.hbm_throttled = false;
+            }
+        }
+    }
+
+    // niri is shutting down: make sure the backlight goes back to the user's level.
+    if current.is_some() {
+        if let Ok(mut c) = Conn::connect() {
+            let _ = c.request(None);
+        }
+    }
+}
