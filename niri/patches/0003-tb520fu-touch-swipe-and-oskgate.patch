diff --git a/src/input/touch_gate.rs b/src/input/touch_gate.rs
new file mode 100644
index 00000000..2ba9c265
--- /dev/null
+++ b/src/input/touch_gate.rs
@@ -0,0 +1,210 @@
+//! TB520FU: Lock-free 64-byte shared-memory touch/keyboard gate (`/run/user/$UID/tb520fu-touch-gate`).
+//!
+//! Written atomically by `niri` on touch down/motion/up/cancel and hardware keyboard presses;
+//! read lock-free by `tb520fu-osk` so automatic `fcitx5` `ShowVirtualKeyboard` requests only
+//! pop up the on-screen keyboard after a genuine single-finger tap on an application window
+//! (suppressing drags, multi-finger gestures, layer-shell bar taps, and physical keyboard focus changes).
+
+use std::collections::HashMap;
+use std::fs::OpenOptions;
+use std::os::fd::AsRawFd;
+use std::path::PathBuf;
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use smithay::backend::input::TouchSlot;
+use smithay::utils::{Logical, Point};
+
+const MAGIC: u64 = 0x5442_3532_3047_4154; // "TB520GAT"
+const FLAG_IS_TAP: u64 = 1 << 0;
+const FLAG_ON_LAYER: u64 = 1 << 1;
+const TAP_SLOP_LOGICAL_PX: f64 = 14.0;
+const TAP_MAX_DURATION: Duration = Duration::from_millis(550);
+
+#[repr(C, align(64))]
+struct TouchGateRaw {
+    magic: AtomicU64,
+    down_ns: AtomicU64,
+    up_ns: AtomicU64,
+    flags: AtomicU64,
+    last_hw_key_ns: AtomicU64,
+    heartbeat_ns: AtomicU64,
+    _reserved: [AtomicU64; 2],
+}
+
+struct ShmHandle {
+    ptr: NonNull<TouchGateRaw>,
+}
+
+// SAFETY: `TouchGateRaw` consists exclusively of `AtomicU64` fields in `MAP_SHARED` memory.
+unsafe impl Send for ShmHandle {}
+unsafe impl Sync for ShmHandle {}
+
+impl Drop for ShmHandle {
+    fn drop(&mut self) {
+        unsafe {
+            libc::munmap(
+                self.ptr.as_ptr().cast::<libc::c_void>(),
+                std::mem::size_of::<TouchGateRaw>(),
+            );
+        }
+    }
+}
+
+fn monotonic_ns() -> u64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    unsafe {
+        libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts);
+    }
+    (ts.tv_sec as u64) * 1_000_000_000 + (ts.tv_nsec as u64)
+}
+
+fn gate_path() -> PathBuf {
+    if let Ok(dir) = std::env::var("XDG_RUNTIME_DIR") {
+        PathBuf::from(dir).join("tb520fu-touch-gate")
+    } else {
+        let uid = unsafe { libc::getuid() };
+        PathBuf::from(format!("/run/user/{uid}/tb520fu-touch-gate"))
+    }
+}
+
+pub struct TouchGateWriter {
+    shm: Option<ShmHandle>,
+    start_points: HashMap<TouchSlot, Point<f64, Logical>>,
+}
+
+impl Default for TouchGateWriter {
+    fn default() -> Self {
+        let shm = Self::open_shm();
+        if let Some(ref h) = shm {
+            let now = monotonic_ns();
+            let r = unsafe { h.ptr.as_ref() };
+            r.heartbeat_ns.store(now, Ordering::Release);
+            r.magic.store(MAGIC, Ordering::Release);
+        }
+        Self {
+            shm,
+            start_points: HashMap::new(),
+        }
+    }
+}
+
+impl TouchGateWriter {
+    fn open_shm() -> Option<ShmHandle> {
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(gate_path())
+            .ok()?;
+        file.set_len(std::mem::size_of::<TouchGateRaw>() as u64).ok()?;
+        let raw = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                std::mem::size_of::<TouchGateRaw>(),
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                file.as_raw_fd(),
+                0,
+            )
+        };
+        if raw == libc::MAP_FAILED {
+            return None;
+        }
+        NonNull::new(raw.cast::<TouchGateRaw>()).map(|ptr| ShmHandle { ptr })
+    }
+
+    #[inline]
+    fn raw(&self) -> Option<&TouchGateRaw> {
+        self.shm.as_ref().map(|h| unsafe { h.ptr.as_ref() })
+    }
+
+    pub fn on_touch_down(&mut self, slot: TouchSlot, pos: Point<f64, Logical>, on_layer: bool) {
+        let was_empty = self.start_points.is_empty();
+        self.start_points.insert(slot, pos);
+        let fingers = self.start_points.len().min(255) as u8;
+        let Some(r) = self.raw() else {
+            return;
+        };
+        let now = monotonic_ns();
+        if was_empty {
+            let mut flags = FLAG_IS_TAP | ((fingers as u64) << 8);
+            if on_layer {
+                flags |= FLAG_ON_LAYER;
+            }
+            r.flags.store(flags, Ordering::Relaxed);
+            r.down_ns.store(now, Ordering::Release);
+            r.heartbeat_ns.store(now, Ordering::Release);
+            r.magic.store(MAGIC, Ordering::Release);
+        } else {
+            self.mark_not_tap(fingers);
+        }
+    }
+
+    pub fn on_touch_motion(&mut self, slot: TouchSlot, pos: Point<f64, Logical>) {
+        let fingers = self.start_points.len().min(255) as u8;
+        if let Some(&start) = self.start_points.get(&slot) {
+            let dx = pos.x - start.x;
+            let dy = pos.y - start.y;
+            if dx * dx + dy * dy >= TAP_SLOP_LOGICAL_PX * TAP_SLOP_LOGICAL_PX {
+                self.mark_not_tap(fingers);
+            }
+        }
+    }
+
+    pub fn mark_not_tap(&self, fingers: u8) {
+        let Some(r) = self.raw() else {
+            return;
+        };
+        let now = monotonic_ns();
+        let prev = r.flags.load(Ordering::Relaxed);
+        let max_f = ((prev >> 8) as u8).max(fingers);
+        let next = (prev & !FLAG_IS_TAP & !(0xFF << 8)) | ((max_f as u64) << 8);
+        r.flags.store(next, Ordering::Release);
+        r.heartbeat_ns.store(now, Ordering::Release);
+    }
+
+    pub fn on_touch_up(&mut self, slot: TouchSlot) {
+        self.start_points.remove(&slot);
+        if !self.start_points.is_empty() {
+            return;
+        }
+        let Some(r) = self.raw() else {
+            return;
+        };
+        let now = monotonic_ns();
+        let down = r.down_ns.load(Ordering::Acquire);
+        if now.saturating_sub(down) > TAP_MAX_DURATION.as_nanos() as u64 {
+            let prev = r.flags.load(Ordering::Relaxed);
+            r.flags.store(prev & !FLAG_IS_TAP, Ordering::Release);
+        }
+        r.up_ns.store(now, Ordering::Release);
+        r.heartbeat_ns.store(now, Ordering::Release);
+        r.magic.store(MAGIC, Ordering::Release);
+    }
+
+    pub fn on_touch_cancel(&mut self) {
+        self.start_points.clear();
+        self.mark_not_tap(0);
+        if let Some(r) = self.raw() {
+            let now = monotonic_ns();
+            r.up_ns.store(now, Ordering::Release);
+            r.heartbeat_ns.store(now, Ordering::Release);
+        }
+    }
+
+    pub fn on_hw_key(&self) {
+        let Some(r) = self.raw() else {
+            return;
+        };
+        let now = monotonic_ns();
+        r.last_hw_key_ns.store(now, Ordering::Release);
+        r.heartbeat_ns.store(now, Ordering::Release);
+        r.magic.store(MAGIC, Ordering::Release);
+    }
+}
