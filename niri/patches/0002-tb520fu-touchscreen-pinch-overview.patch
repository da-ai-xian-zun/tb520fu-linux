diff --git a/src/input/touch_pinch.rs b/src/input/touch_pinch.rs
new file mode 100644
index 00000000..bc267e2c
--- /dev/null
+++ b/src/input/touch_pinch.rs
@@ -0,0 +1,222 @@
+//! TB520FU: multi-finger pinch on the touchscreen opens / closes the overview.
+//!
+//! With at least `min_fingers` (default 3, env `NIRI_TOUCH_PINCH_FINGERS`) fingers down, pinching
+//! in while the overview is closed, or spreading out while it is open, takes the touch sequence
+//! over: clients get `wl_touch.cancel` and the change of the fingers' mean distance from their
+//! centroid drives the same overview gesture the touchpad swipe uses. Spreading out over a window
+//! in the overview activates that window, so the overview closes into it. Lifting any finger ends
+//! the gesture; the rest of the sequence is swallowed until all fingers are up.
+
+use std::collections::HashMap;
+use std::time::Duration;
+
+use smithay::backend::input::TouchSlot;
+use smithay::desktop::Window;
+use smithay::utils::{Logical, Point};
+
+use crate::niri::State;
+
+// Ratio of the fingers' spread to its starting value that starts the gesture.
+const PINCH_IN_START: f64 = 0.85;
+const SPREAD_OUT_START: f64 = 1.18;
+// A spread change of this fraction of the starting spread covers the whole open/close movement.
+const FULL_MOVEMENT_FRACTION: f64 = 0.45;
+// Matches OVERVIEW_GESTURE_MOVEMENT in layout/mod.rs.
+const OVERVIEW_GESTURE_MOVEMENT: f64 = 300.;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum PinchState {
+    /// Watching; events go to clients as usual.
+    #[default]
+    Idle,
+    /// Driving the overview gesture; events are swallowed.
+    Active,
+    /// Gesture ended, waiting for the remaining fingers to lift; events are swallowed.
+    Finishing,
+}
+
+pub struct TouchPinch {
+    points: HashMap<TouchSlot, Point<f64, Logical>>,
+    state: PinchState,
+    start_spread: f64,
+    last_spread: f64,
+    scale: f64,
+    window: Option<Window>,
+    min_fingers: usize,
+    /// Set while we cancel the touch grab, so the overview touch grab does not treat its own
+    /// teardown as a tap.
+    pub cancelling: bool,
+}
+
+impl Default for TouchPinch {
+    fn default() -> Self {
+        let min_fingers = std::env::var("NIRI_TOUCH_PINCH_FINGERS")
+            .ok()
+            .and_then(|v| v.trim().parse::<usize>().ok())
+            .filter(|n| (2..=10).contains(n))
+            .unwrap_or(3);
+        Self {
+            points: HashMap::new(),
+            state: PinchState::Idle,
+            start_spread: 0.,
+            last_spread: 0.,
+            scale: 0.,
+            window: None,
+            min_fingers,
+            cancelling: false,
+        }
+    }
+}
+
+impl TouchPinch {
+    fn spread(&self) -> Option<(Point<f64, Logical>, f64)> {
+        let n = self.points.len();
+        if n == 0 {
+            return None;
+        }
+        let mut c = Point::<f64, Logical>::from((0., 0.));
+        for p in self.points.values() {
+            c += *p;
+        }
+        let c = Point::<f64, Logical>::from((c.x / n as f64, c.y / n as f64));
+        let r = self
+            .points
+            .values()
+            .map(|p| ((p.x - c.x).powi(2) + (p.y - c.y).powi(2)).sqrt())
+            .sum::<f64>()
+            / n as f64;
+        Some((c, r))
+    }
+
+    fn reset_start(&mut self) {
+        if let Some((_, r)) = self.spread() {
+            self.start_spread = r;
+            self.last_spread = r;
+        }
+    }
+
+    pub fn swallowing(&self) -> bool {
+        self.state != PinchState::Idle
+    }
+}
+
+impl State {
+    /// Returns true when the touch-down must not reach the seat (gesture in progress).
+    pub fn touch_pinch_down(&mut self, slot: TouchSlot, pos: Point<f64, Logical>) -> bool {
+        let p = &mut self.niri.touch_pinch;
+        p.points.insert(slot, pos);
+        if p.state != PinchState::Idle {
+            return true;
+        }
+        // (Re)start measuring whenever another finger joins.
+        if p.points.len() >= p.min_fingers {
+            p.reset_start();
+        }
+        false
+    }
+
+    /// Returns true when the motion must not reach the seat.
+    pub fn touch_pinch_motion(
+        &mut self,
+        slot: TouchSlot,
+        pos: Point<f64, Logical>,
+        timestamp: Duration,
+    ) -> bool {
+        let p = &mut self.niri.touch_pinch;
+        if !p.points.contains_key(&slot) {
+            return p.swallowing();
+        }
+        p.points.insert(slot, pos);
+
+        match p.state {
+            PinchState::Finishing => true,
+            PinchState::Active => {
+                let (_, r) = p.spread().unwrap();
+                let delta = (p.last_spread - r) * p.scale;
+                p.last_spread = r;
+                if self
+                    .niri
+                    .layout
+                    .overview_gesture_update(delta, timestamp)
+                    .is_some()
+                {
+                    self.niri.queue_redraw_all();
+                }
+                true
+            }
+            PinchState::Idle => {
+                if p.points.len() < p.min_fingers || p.start_spread < 1. {
+                    return false;
+                }
+                let (centroid, r) = p.spread().unwrap();
+                let ratio = r / p.start_spread;
+                let open = self.niri.layout.is_overview_open();
+                if !((!open && ratio < PINCH_IN_START) || (open && ratio > SPREAD_OUT_START)) {
+                    return false;
+                }
+
+                // Take the sequence over.
+                let start = p.start_spread;
+                p.state = PinchState::Active;
+                p.scale = OVERVIEW_GESTURE_MOVEMENT / (FULL_MOVEMENT_FRACTION * start).max(40.);
+                p.last_spread = r;
+                let scale = p.scale;
+                let window = if open {
+                    self.niri.window_under(centroid).map(|m| m.window.clone())
+                } else {
+                    None
+                };
+                self.niri.touch_pinch.window = window;
+
+                self.niri.touch_pinch.cancelling = true;
+                if let Some(handle) = self.niri.seat.get_touch() {
+                    handle.cancel(self);
+                }
+                self.niri.touch_pinch.cancelling = false;
+
+                self.niri.layout.overview_gesture_begin();
+                // Apply the movement made before the threshold so the view does not lag behind.
+                self.niri
+                    .layout
+                    .overview_gesture_update((start - r) * scale, timestamp);
+                self.niri.queue_redraw_all();
+                true
+            }
+        }
+    }
+
+    /// Bookkeeping for a lifted finger. Ups always reach the seat (after a cancel they are no-ops).
+    pub fn touch_pinch_up(&mut self, slot: TouchSlot) {
+        let p = &mut self.niri.touch_pinch;
+        p.points.remove(&slot);
+        if p.state == PinchState::Active {
+            p.state = PinchState::Finishing;
+            if let Some(window) = self.niri.touch_pinch.window.take() {
+                self.niri.layout.activate_window(&window);
+            }
+            if self.niri.layout.overview_gesture_end() {
+                self.niri.queue_redraw_all();
+            }
+        }
+        let p = &mut self.niri.touch_pinch;
+        if p.points.is_empty() {
+            p.state = PinchState::Idle;
+            p.start_spread = 0.;
+        } else if p.state == PinchState::Idle && p.points.len() >= p.min_fingers {
+            p.reset_start();
+        }
+    }
+
+    /// The whole touch sequence was cancelled by the device.
+    pub fn touch_pinch_cancel(&mut self) {
+        let active = self.niri.touch_pinch.state == PinchState::Active;
+        let p = &mut self.niri.touch_pinch;
+        p.points.clear();
+        p.state = PinchState::Idle;
+        p.start_spread = 0.;
+        p.window = None;
+        if active && self.niri.layout.overview_gesture_end() {
+            self.niri.queue_redraw_all();
+        }
+    }
+}
