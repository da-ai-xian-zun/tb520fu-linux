+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detect autofocus for the simple pipeline handler
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/controls.h>
+
+namespace libcamera {
+
+class CameraLens;
+
+class SimpleAutoFocus
+{
+public:
+	SimpleAutoFocus(CameraLens *lens, const ControlInfo &range);
+
+	void addControls(ControlInfoMap::Map &controls) const;
+
+	int start();
+	void stop();
+
+	int queueRequest(const ControlList &controls);
+	void process(uint32_t frame, const ControlList &metadata);
+	void fillMetadata(ControlList &metadata) const;
+
+private:
+	enum class Phase {
+		Idle,
+		Warmup,
+		Coarse,
+		Fine,
+		Verify,
+		Locked,
+	};
+
+	int moveTo(int32_t position);
+	void startScan();
+	void nextTarget();
+	void finishScan();
+
+	CameraLens *lens_;
+	int32_t min_;
+	int32_t max_;
+	int32_t position_;
+
+	int32_t mode_;
+	int32_t state_;
+	Phase phase_;
+
+	/* Frame number of the newest metadata when the lens last moved. */
+	uint32_t lastFrame_;
+	uint32_t moveFrame_;
+	unsigned int warmup_;
+
+	std::vector<int32_t> targets_;
+	size_t target_;
+	int32_t bestPosition_;
+	int32_t bestFoM_;
+	int32_t lockedFoM_;
+	int32_t lastFoM_;
+	unsigned int lowCount_;
+	bool disturbed_;
+};
+
+} /* namespace libcamera */
