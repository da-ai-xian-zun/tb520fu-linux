[Unit]
Description=TB520FU Hardware & Sensor Daemon (Power Key, Lid Switch, Stylus Charge, ALS Auto-Brightness, 90% Bypass Power, Torch)
After=systemd-udevd.service dbus.service systemd-logind.service iio-sensor-proxy.service
Wants=dbus.service
Conflicts=tb520fu-power-key.service tb520fu-pen-charge.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tb520fu-daemon
Restart=always
RestartSec=1
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
