[Unit]
Description=TB520FU OriginOS Pure-Rust Desktop Shell (StatusBar, Control Center, Notifications, Launcher, Lockscreen)
ConditionUser=!@system
PartOf=graphical-session.target
After=graphical-session.target niri.service pipewire.service
Wants=pipewire.service
Conflicts=tb520fu-mute-led.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tb520fu-shell
Restart=always
RestartSec=1

[Install]
WantedBy=niri.service graphical-session.target
