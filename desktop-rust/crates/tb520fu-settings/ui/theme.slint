export struct WifiRow {
    ssid: string,
    subtitle: string,
    strength: int,
    secure: bool,
    saved: bool,
}

export struct BtRow {
    path: string,
    mac: string,
    name: string,
    subtitle: string,
    is-pen: bool,
    connected: bool,
    has-battery: bool,
    battery-text: string,
}

export struct AudioRow {
    id: int,
    name: string,
    subtitle: string,
    is-bt: bool,
    active: bool,
}

export struct SuspendRow {
    started: string,
    duration: string,
    delta-cap: string,
    avg-power: string,
}

export struct NotifAppRow {
    name: string,
    enabled: bool,
}

export struct SearchHit {
    page-id: string,
    section-tag: string,
    title: string,
    page-label: string,
}

