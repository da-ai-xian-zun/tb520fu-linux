    out property <image> sun: @image-url("icons/sun.svg");
    out property <image> sound: @image-url("icons/sound.svg");
    out property <image> battery: @image-url("icons/battery.svg");
    out property <image> pen: @image-url("icons/pen.svg");
    out property <image> gear: @image-url("icons/gear.svg");
    out property <image> search: @image-url("icons/search.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> chev-down: @image-url("icons/chev-down.svg");
    out property <image> chev-right: @image-url("icons/chev-right.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> lock: @image-url("icons/lock.svg");
    out property <image> eye: @image-url("icons/eye.svg");
    out property <image> book: @image-url("icons/book.svg");
    out property <image> hz: @image-url("icons/hz.svg");
    out property <image> rotate: @image-url("icons/rotate.svg");
    out property <image> scale: @image-url("icons/scale.svg");
    out property <image> monitor: @image-url("icons/monitor.svg");
    out property <image> mic: @image-url("icons/mic.svg");
    out property <image> headphone: @image-url("icons/headphone.svg");
    out property <image> clock: @image-url("icons/clock.svg");
    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> globe: @image-url("icons/globe.svg");
    out property <image> touchpad: @image-url("icons/touchpad.svg");
    out property <image> tablet: @image-url("icons/tablet.svg");
    out property <image> palette: @image-url("icons/palette.svg");
    out property <image> bell: @image-url("icons/bell.svg");
