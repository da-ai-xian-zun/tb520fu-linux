import { Theme, Icons } from "theme.slint";

export component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <bool> first: false;
    height: root.first ? 24px : 38px;
    background: transparent;
    Text {
        x: 6px;
        y: root.first ? 3px : 16px;
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: Theme.sub;
    }
}

export component Card inherits Rectangle {
    in property <bool> pulse: false;
    border-radius: 18px;
    border-width: root.pulse ? 2px : 1px;
    border-color: root.pulse ? Theme.accent : Theme.glass-border;
    background: root.pulse
        ? @linear-gradient(160deg, Theme.accent-soft 0%, Theme.card-glass-bot 100%)
        : @linear-gradient(165deg, Theme.card-glass-top 0%, Theme.card-glass-mid 46%, Theme.card-glass-bot 100%);
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.card-shadow;
    clip: true;

    Rectangle {
        x: 18px;
        y: 0px;
        z: 10;
        width: Math.max(0px, parent.width - 36px);
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, Theme.glass-specular 50%, #ffffff00 100%);
    }

    VerticalLayout {
        @children
    }
}

export component CardGap inherits Rectangle {
    height: 12px;
    background: transparent;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: @linear-gradient(90deg, #ffffff00 0%, Theme.line 12%, Theme.line 88%, #ffffff00 100%);
}

export component RowIconBadge inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.active ? Theme.accent-soft : Theme.glass-sub-border;
    background: root.active
        ? @linear-gradient(155deg, Theme.accent-soft 0%, Theme.glass-sub-bot 100%)
        : @linear-gradient(155deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%);

    Image {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.active ? Theme.accent-ink : Theme.ink-muted;
    }
}

export component SignalBars inherits Rectangle {
    in property <int> strength: 80;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.glass-sub-border;
    background: @linear-gradient(155deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%);

    property <int> bars: root.strength >= 75 ? 4 : (root.strength >= 50 ? 3 : (root.strength >= 25 ? 2 : 1));

    HorizontalLayout {
        x: 8px;
        y: 9px;
        width: 18px;
        height: 16px;
        spacing: 2px;
        alignment: center;

        Rectangle {
            y: 10px; width: 3px; height: 6px; border-radius: 1.5px;
            background: root.bars >= 1 ? Theme.ink : Theme.slider-track;
        }
        Rectangle {
            y: 7px; width: 3px; height: 9px; border-radius: 1.5px;
            background: root.bars >= 2 ? Theme.ink : Theme.slider-track;
        }
        Rectangle {
            y: 4px; width: 3px; height: 12px; border-radius: 1.5px;
            background: root.bars >= 3 ? Theme.ink : Theme.slider-track;
        }
        Rectangle {
            y: 1px; width: 3px; height: 15px; border-radius: 1.5px;
            background: root.bars >= 4 ? Theme.ink : Theme.slider-track;
        }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> lead-icon;
    in property <bool> has-lead-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    width: inner.preferred-width;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.primary ? #ffffff4a : Theme.glass-sub-border;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.primary
        ? (ta.has-hover && root.enabled
            ? @linear-gradient(160deg, Theme.accent-hover 0%, Theme.accent-hover 100%)
            : @linear-gradient(160deg, Theme.accent-hover 0%, Theme.accent 100%))
        : (ta.has-hover && root.enabled
            ? @linear-gradient(160deg, Theme.glass-sub-hover 0%, Theme.glass-sub-top 100%)
            : @linear-gradient(160deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%));
    clip: true;

    Rectangle {
        x: 8px;
        y: 0px;
        width: Math.max(0px, parent.width - 16px);
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, Theme.glass-specular 50%, #ffffff00 100%);
    }

    inner := HorizontalLayout {
        height: 100%;
        padding-left: 13px;
        padding-right: 13px;
        spacing: 5px;
        alignment: center;
        if root.has-lead-icon : VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.lead-icon;
                colorize: root.primary ? #ffffff : Theme.ink;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #ffffff : (root.danger ? Theme.danger : Theme.ink);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component TagPill inherits Rectangle {
    in property <string> text;
    in property <bool> green: false;
    in property <bool> blue: false;

    height: 25px;
    width: tag-lay.preferred-width;
    border-radius: 12.5px;
    border-width: 1px;
    border-color: root.green ? #10b98140 : (root.blue ? Theme.accent-soft : Theme.glass-sub-border);
    background: root.green ? Theme.green-soft : (root.blue ? Theme.accent-soft : Theme.glass-sub-bot);

    tag-lay := HorizontalLayout {
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 600;
            color: root.green ? Theme.green : (root.blue ? Theme.accent-ink : Theme.sub);
            vertical-alignment: center;
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "搜索设置项…";
    callback edited(string);
    callback cleared();

    public function focus-input() {
        inp.focus();
    }

    height: 40px;
    border-radius: 12px;
    border-width: 1px;
    border-color: inp.has-focus ? Theme.accent : Theme.glass-sub-border;
    background: inp.has-focus
        ? @linear-gradient(160deg, Theme.glass-sub-hover 0%, Theme.glass-sub-top 100%)
        : (bg-ta.has-hover
            ? @linear-gradient(160deg, Theme.glass-sub-hover 0%, Theme.glass-sub-bot 100%)
            : @linear-gradient(160deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%));

    bg-ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { inp.focus(); }
    }

    Image {
        x: 11px;
        y: (parent.height - 15px) / 2;
        width: 15px;
        height: 15px;
        source: Icons.search;
        colorize: Theme.sub;
    }

    if root.text == "" : Text {
        x: 34px;
        height: 100%;
        text: root.placeholder;
        font-size: 13.5px;
        color: Theme.sub;
        vertical-alignment: center;
    }

    inp := TextInput {
        x: 34px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 70px;
        text <=> root.text;
        font-size: 13.5px;
        color: Theme.ink;
        single-line: true;
        edited => { root.edited(self.text); }
    }

    if root.text == "" : Rectangle {
        x: parent.width - 28px;
        y: (parent.height - 20px) / 2;
        width: 19px;
        height: 20px;
        border-radius: 5px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.card-bg;
        Text {
            text: "/";
            font-size: 11px;
            font-weight: 600;
            color: Theme.sub;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.text != "" : Rectangle {
        x: parent.width - 31px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: clr-ta.has-hover ? Theme.tile-hover : transparent;
        Text {
            text: "✕";
            font-size: 12px;
            color: Theme.sub;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        clr-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.text = "";
                root.cleared();
            }
        }
    }
}

export component ModalField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> password: false;
    callback accepted();

    public function focus-input() {
        inp.focus();
    }

    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: inp.has-focus ? Theme.accent : Theme.glass-sub-border;
    background: @linear-gradient(160deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%);

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { inp.focus(); }
    }

    if root.text == "" : Text {
        x: 13px;
        height: 100%;
        text: root.placeholder;
        font-size: 14px;
        color: Theme.sub;
        vertical-alignment: center;
    }

    inp := TextInput {
        x: 13px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 26px;
        text <=> root.text;
        input-type: root.password ? InputType.password : InputType.text;
        font-size: 14.5px;
        color: Theme.ink;
        single-line: true;
        accepted => { root.accepted(); }
    }
}

export component SwitchPill inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 48px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.checked ? #ffffff42 : Theme.glass-well-border;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.checked
        ? @linear-gradient(160deg, Theme.accent-hover 0%, Theme.accent 100%)
        : @linear-gradient(160deg, Theme.glass-well-bg 0%, Theme.slider-track 100%);

    Rectangle {
        x: root.checked ? 23px : 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        border-width: 1px;
        border-color: #00000014;
        background: @linear-gradient(175deg, #ffffff 0%, #eef2f8 100%);
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000036;
        animate x { duration: 160ms; easing: ease-out; }
    }

    TouchArea {
        width: 54px;
        height: 44px;
        x: -4px;
        y: -8px;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

export component SwitchRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> title;
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> pulse: false;
    callback toggled(bool);

    min-height: root.subtitle == "" ? 54px : 60px;
    background: root.pulse ? Theme.accent-soft : (row-ta.has-hover && root.enabled ? Theme.tile-bg : transparent);
    animate background { duration: 140ms; }

    row-ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;

        if root.has-icon : VerticalLayout {
            alignment: center;
            RowIconBadge { icon: root.icon; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14.5px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.sub;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            SwitchPill {
                checked <=> root.checked;
                enabled: root.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

export component SliderRow inherits FocusScope {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> title;
    in-out property <int> value: 50;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> unit: "%";
    in property <bool> pulse: false;
    callback changed(int);

    min-height: 54px;

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.value = Math.max(root.minimum, root.value - (event.modifiers.shift ? 5 : 2));
            root.changed(root.value);
            return accept;
        }
        if (event.text == Key.RightArrow) {
            root.value = Math.min(root.maximum, root.value + (event.modifiers.shift ? 5 : 2));
            root.changed(root.value);
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.pulse ? Theme.accent-soft : (ta.has-hover ? #ffffff05 : transparent);

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;

            if root.has-icon : VerticalLayout {
                alignment: center;
                Image {
                    width: 19px;
                    height: 19px;
                    source: root.icon;
                    colorize: Theme.ink-muted;
                }
            }

            VerticalLayout {
                alignment: center;
                width: 76px;
                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.ink;
                }
            }

            track-box := Rectangle {
                horizontal-stretch: 1;
                min-width: 110px;
                height: 44px;

                property <float> ratio: Math.clamp((root.value - root.minimum) * 1.0 / Math.max(1, root.maximum - root.minimum), 0.0, 1.0);

                Rectangle {
                    y: (parent.height - 6px) / 2;
                    width: 100%;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.slider-track;
                }

                Rectangle {
                    x: 0px;
                    y: (parent.height - 6px) / 2;
                    width: parent.width * parent.ratio;
                    height: 6px;
                    border-radius: 3px;
                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-hover 100%);
                }

                Rectangle {
                    x: Math.clamp(parent.width * parent.ratio - 11px, 0px, Math.max(0px, parent.width - 22px));
                    y: (parent.height - 22px) / 2;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: @linear-gradient(175deg, #ffffff 0%, #edf1f8 100%);
                    border-width: root.has-focus ? 2px : 1px;
                    border-color: root.has-focus ? Theme.accent : #0f172a24;
                    drop-shadow-blur: 5px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #00000033;
                }

                ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.focus();
                            self.update-from-x(self.mouse-x);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.update-from-x(self.mouse-x);
                        }
                    }
                    scroll-event(ev) => {
                        if (ev.delta-y > 0px) {
                            root.value = Math.min(root.maximum, root.value + 2);
                            root.changed(root.value);
                            return accept;
                        }
                        if (ev.delta-y < 0px) {
                            root.value = Math.max(root.minimum, root.value - 2);
                            root.changed(root.value);
                            return accept;
                        }
                        return reject;
                    }

                    function update-from-x(mx: length) {
                        let r = Math.clamp(mx / Math.max(1px, track-box.width), 0.0, 1.0);
                        let nv = Math.round(root.minimum + r * (root.maximum - root.minimum));
                        if (nv != root.value) {
                            root.value = nv;
                            root.changed(nv);
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                width: 48px;
                Text {
                    text: root.value + root.unit;
                    font-size: 13.5px;
                    font-weight: 600;
                    color: Theme.sub;
                    horizontal-alignment: right;
                }
            }
        }
    }
}

export component SegmentedBar inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> selected: 0;
    callback changed(int);

    height: 40px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.glass-well-border;
    background: Theme.glass-well-bg;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for item[idx] in root.labels : Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: 9px;
            border-width: idx == root.selected ? 1px : 0px;
            border-color: #ffffff4a;
            background: idx == root.selected
                ? @linear-gradient(160deg, Theme.accent-hover 0%, Theme.accent 100%)
                : (seg-ta.has-hover
                    ? @linear-gradient(160deg, Theme.tile-hover 0%, Theme.tile-bg 100%)
                    : @linear-gradient(160deg, #ffffff00 0%, #ffffff00 100%));

            Text {
                text: item;
                font-size: 13px;
                font-weight: idx == root.selected ? 700 : 500;
                color: idx == root.selected ? #ffffff : Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.selected != idx) {
                        root.selected = idx;
                        root.changed(idx);
                    }
                }
            }
        }
    }
}

// Compact right-aligned segmented row (matches Prototype's Appearance & External Position rows!)
export component InlineSegRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> title;
    in property <string> subtitle: "";
    in property <[string]> labels;
    in-out property <int> selected: 0;
    in property <bool> pulse: false;
    callback changed(int);

    min-height: root.subtitle == "" ? 54px : 62px;
    background: root.pulse ? Theme.accent-soft : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;

        if root.has-icon : VerticalLayout {
            alignment: center;
            RowIconBadge { icon: root.icon; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14.5px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.sub;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 36px;
                width: seg-lay.preferred-width;
                border-radius: 11px;
                border-width: 1px;
                border-color: Theme.glass-well-border;
                background: Theme.glass-well-bg;

                seg-lay := HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    for item[idx] in root.labels : Rectangle {
                        height: 30px;
                        width: it-lbl.preferred-width + 24px;
                        border-radius: 8px;
                        border-width: idx == root.selected ? 1px : 0px;
                        border-color: #ffffff4a;
                        background: idx == root.selected
                            ? @linear-gradient(160deg, Theme.accent-hover 0%, Theme.accent 100%)
                            : (it-ta.has-hover
                                ? @linear-gradient(160deg, Theme.tile-hover 0%, Theme.tile-bg 100%)
                                : @linear-gradient(160deg, #ffffff00 0%, #ffffff00 100%));

                        it-lbl := Text {
                            text: item;
                            font-size: 13px;
                            font-weight: idx == root.selected ? 700 : 500;
                            color: idx == root.selected ? #ffffff : Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        it-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.selected != idx) {
                                    root.selected = idx;
                                    root.changed(idx);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Compact right-aligned dropdown selector row (matches Prototype's <select> pills!)
export component SelectRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> value-text: "";
    in property <bool> pulse: false;
    callback open-picker();

    min-height: root.subtitle == "" ? 54px : 60px;
    background: root.pulse ? Theme.accent-soft : (row-ta.has-hover ? Theme.tile-bg : transparent);

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-picker(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;

        if root.has-icon : VerticalLayout {
            alignment: center;
            RowIconBadge { icon: root.icon; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14.5px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.sub;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 36px;
                width: pill-lay.preferred-width;
                border-radius: 11px;
                border-width: 1px;
                border-color: Theme.glass-sub-border;
                background: row-ta.has-hover
                    ? @linear-gradient(160deg, Theme.glass-sub-hover 0%, Theme.glass-sub-top 100%)
                    : @linear-gradient(160deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%);
                clip: true;

                Rectangle {
                    x: 8px;
                    y: 0px;
                    width: Math.max(0px, parent.width - 16px);
                    height: 1px;
                    background: @linear-gradient(90deg, #ffffff00 0%, Theme.glass-specular 50%, #ffffff00 100%);
                }

                pill-lay := HorizontalLayout {
                    height: 100%;
                    padding-left: 12px;
                    padding-right: 11px;
                    spacing: 7px;
                    alignment: center;
                    Text {
                        text: root.value-text;
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 14px;
                            height: 14px;
                            source: Icons.chev-down;
                            colorize: Theme.sub;
                        }
                    }
                }
            }
        }
    }
}

export component KeyValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    min-height: 44px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: 13.5px;
                color: Theme.sub;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.value;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.ink;
                horizontal-alignment: right;
            }
        }
    }
}

export component ShortcutBadgeRow inherits Rectangle {
    in property <string> label;
    in property <string> combo;
    min-height: 44px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 13.5px;
                font-weight: 500;
                color: Theme.ink;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                width: kbd-lay.preferred-width;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.glass-sub-border;
                background: @linear-gradient(160deg, Theme.glass-sub-top 0%, Theme.glass-sub-bot 100%);

                kbd-lay := HorizontalLayout {
                    height: 100%;
                    padding-left: 9px;
                    padding-right: 9px;
                    alignment: center;
                    Text {
                        text: root.combo;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.ink-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
