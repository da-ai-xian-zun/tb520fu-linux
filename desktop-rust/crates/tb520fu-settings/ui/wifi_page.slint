import { Theme, Icons, WifiRow } from "theme.slint";
import { SectionTitle, Card, CardGap, Divider, RowIconBadge, SignalBars, PillButton, TagPill, SwitchPill, SwitchRow } from "widgets.slint";

export component WifiPage inherits VerticalLayout {
    in property <bool> wifi-enabled: true;
    in property <bool> airplane-mode: false;
    in property <string> wired-summary: "";
    in property <bool> scanning: false;
    in property <bool> has-active: false;
    in property <string> active-ssid: "";
    in property <string> active-detail: "";
    in property <[WifiRow]> networks: [];
    in property <string> pulse-tag: "";

    callback toggle-wifi(bool);
    callback toggle-airplane(bool);
    callback rescan();
    callback forget-active(string);
    callback select-network(WifiRow);

    spacing: 0px;

    Card {
        pulse: root.pulse-tag == "wifi-sw" || root.pulse-tag == "airplane";
        VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    RowIconBadge { icon: Icons.wifi; active: root.wifi-enabled; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "无线局域网";
                        font-size: 14.5px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Text {
                        text: !root.wifi-enabled ? "已关闭" : (root.has-active ? "已连接 " + root.active-ssid : "未连接");
                        font-size: 12px;
                        color: Theme.sub;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    if root.wifi-enabled : VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: root.scanning ? "扫描中…" : "刷新";
                            enabled: !root.scanning;
                            clicked => { root.rescan(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SwitchPill {
                            checked: root.wifi-enabled;
                            toggled(v) => { root.toggle-wifi(v); }
                        }
                    }
                }
            }
            Divider {}
            SwitchRow {
                has-icon: true;
                icon: Icons.plane;
                title: "飞行模式";
                subtitle: "关闭无线局域网与蓝牙";
                checked: root.airplane-mode;
                toggled(v) => { root.toggle-airplane(v); }
            }
        }
    }

    if root.wired-summary != "" : VerticalLayout {
        spacing: 0px;
        SectionTitle { text: "以太网与 USB 共享"; }
        Card {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    RowIconBadge { icon: Icons.globe; active: true; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "有线与共享网络";
                        font-size: 14.5px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Text {
                        text: root.wired-summary;
                        font-size: 12px;
                        color: Theme.sub;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TagPill { text: "已连通"; green: true; }
                }
            }
        }
    }

    if root.wifi-enabled && root.has-active : VerticalLayout {
        spacing: 0px;
        SectionTitle { text: "当前连接"; }
        Card {
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    RowIconBadge { icon: Icons.wifi; active: true; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.active-ssid;
                        font-size: 14.5px;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                    Text {
                        text: root.active-detail;
                        font-size: 12px;
                        color: Theme.sub;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout { alignment: center; TagPill { text: "已连接"; green: true; } }
                    VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "忘记";
                            danger: true;
                            clicked => { root.forget-active(root.active-ssid); }
                        }
                    }
                }
            }
        }
    }

    if root.wifi-enabled : VerticalLayout {
        spacing: 0px;
        SectionTitle { text: "可用网络"; }
        Card {
            VerticalLayout {
                if root.networks.length == 0 : Rectangle {
                    min-height: 54px;
                    Text {
                        text: root.scanning ? "正在搜索附近网络…" : "暂无其它可用网络";
                        font-size: 13px;
                        color: Theme.sub;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for net[idx] in root.networks : VerticalLayout {
                    if idx > 0 : Divider {}
                    Rectangle {
                        min-height: 56px;
                        background: net-ta.has-hover ? Theme.tile-bg : transparent;
                        animate background { duration: 120ms; }

                        net-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select-network(net); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                SignalBars { strength: net.strength; }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: net.ssid;
                                    font-size: 14.5px;
                                    font-weight: 600;
                                    color: Theme.ink;
                                    overflow: elide;
                                }
                                Text {
                                    text: net.subtitle;
                                    font-size: 12px;
                                    color: Theme.sub;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                if net.saved : VerticalLayout { alignment: center; TagPill { text: "已保存"; blue: true; } }
                                if net.secure : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        width: 15px;
                                        height: 15px;
                                        source: Icons.lock;
                                        colorize: Theme.sub;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        width: 15px;
                                        height: 15px;
                                        source: Icons.chev-right;
                                        colorize: Theme.sub;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    CardGap {}
}
